---
/* ============================================================================
   Eine dynamische Route für zwei Seitentypen:
     · Hub-Seiten   (hub-werkstatt.html, hub-kueche.html, …)
     · native Module (koch-basics.html, …) — deren Inhalte liegen als
       src/content/<modul-id>/<abschnitt-hash>.astro

   Ein Modul gilt als „nativ", sobald sein Ordner unter src/content/ existiert.
   Der Build wacht darüber, dass Registry-Abschnitte und Content-Dateien
   deckungsgleich sind — läuft etwas auseinander, bricht er ab.
   ========================================================================== */
import Base from "../layouts/Base.astro";
import HubCard from "../components/HubCard.astro";
import { hubs, moduleById, hubById, relatedOf, fmtDate } from "../lib/registry.mjs";

export function getStaticPaths() {
  const files = import.meta.glob("../content/*/*.astro");
  const nativeIds = [...new Set(Object.keys(files).map((p) => p.split("/")[2]))];
  const paths = [];
  for (const h of hubs) {
    paths.push({ params: { slug: h.file.replace(/\.html$/, "") }, props: { type: "hub", id: h.id } });
  }
  for (const id of nativeIds) {
    const m = moduleById(id);
    if (!m) throw new Error(`src/content/${id}/ hat keinen Registry-Eintrag`);
    paths.push({ params: { slug: m.file.replace(/\.html$/, "") }, props: { type: "mod", id } });
  }
  return paths;
}

const { type, id } = Astro.props;
const hub = type === "hub" ? hubById(id) : moduleById(id).hub;
const mod = type === "mod" ? moduleById(id) : null;

/* Abschnitts-Komponenten laden und gegen die Registry prüfen. */
const secFiles = import.meta.glob("../content/*/*.astro", { eager: true });
const secComp = (mid, h) => {
  const f = secFiles[`../content/${mid}/${h}.astro`];
  if (!f) throw new Error(`Fehlender Abschnitt: src/content/${mid}/${h}.astro`);
  return f.default;
};
if (mod) {
  const have = Object.keys(secFiles)
    .filter((p) => p.split("/")[2] === mod.id)
    .map((p) => p.split("/")[3].replace(/\.astro$/, ""));
  const want = mod.sections.map((s) => s.h);
  for (const h of have) {
    if (!want.includes(h)) throw new Error(`src/content/${mod.id}/${h}.astro fehlt in der Registry`);
  }
}

const related = relatedOf(id).filter((m) => !mod || m.id !== mod.id);
const SHOWN = 8;
const title = mod ? `${mod.name} · ${hub.name} · Artefakte` : `${hub.name} · Artefakte`;
const desc = mod ? mod.desc : `${hub.name} — ${hub.desc}`;

/* Sidebar-Gliederung: Gruppen aus der Registry oder eine flache Liste. */
const secTitle = (h: string) => mod.sections.find((s: any) => s.h === h)?.t || h;
const navGroups = mod
  ? mod.groups
    ? mod.groups.map((g: any) => ({ label: g.l, hashes: g.sections }))
    : [{ label: null, hashes: mod.sections.map((s: any) => s.h) }]
  : [];

/* Zusatz-Skript des Moduls (Rechner, Tabellen-Builder, Folds …). */
const PAGE_SCRIPTS: Record<string, string> = {
  loeten: "/assets/mod-loeten.js",
  "elektronik-101": "/assets/mod-elektronik.js",
  dremel: "/assets/mod-dremel.js",
  homeserver: "/assets/mod-homeserver.js",
  maschinenbau: "/assets/mod-maschinenbau.js",
  "maker-komponenten": "/assets/mod-maker-komponenten.js",
  robotik: "/assets/mod-robotik.js",
  filament: "/assets/mod-filament.js",
  rentabilitaet: "/assets/mod-rentabilitaet.js",
  schmiermittel: "/assets/mod-schmiermittel.js",
};
const pageScript = mod ? PAGE_SCRIPTS[mod.id] : undefined;
const routerCfg = mod ? JSON.stringify({ alias: mod.alias || {} }) : "{}";
---

<Base title={title} description={desc} hub={hub} mod={mod}>
  {
    /* ================================ HUB-SEITE ================================ */
    !mod && (
      <>
        <header class="hero">
          <div class="wrap">
            <div class="kicker">{hub.tagline}</div>
            <h1><span class="ic">{hub.icon}</span>{hub.name}</h1>
            <p class="lead">{hub.desc}</p>
            <button class="bigsearch" type="button" data-hbx-search>
              <span aria-hidden="true">🔍</span>
              <span class="t">In diesem Hub und allen anderen suchen …</span>
              <span class="k">⌘K</span>
            </button>
            <div class="stats">
              <span><b>{hub.modules.length}</b> Module</span>
              <span><b>{hub.sectionCount}</b> Abschnitte</span>
              <span><b>{hub.areas.length}</b> Bereiche</span>
              <span>zuletzt <b>{fmtDate(hub.updated)}</b></span>
            </div>
            <nav class="jump" aria-label="Bereiche">
              {hub.areas.map((ar) => (
                <a href={`#a-${ar.id}`}>{ar.name} <span class="ct">{ar.modules.length}</span></a>
              ))}
            </nav>
          </div>
        </header>

        <main>
          <div class="wrap">
            {hub.areas.map((ar) => (
              <section class="area" id={`a-${ar.id}`}>
                <div class="area-head">
                  <h2>{ar.name}</h2>
                  <span class="ct">{ar.modules.length} Module</span>
                </div>
                <p class="d">{ar.desc}</p>
                <div class="modgrid">
                  {ar.modules.map((m) => (
                    <article class="mod">
                      <div class="hd">
                        <span class="ic">{m.icon}</span>
                        <h3><a href={m.file}>{m.name}</a></h3>
                        <span class="kind">{m.kind}</span>
                      </div>
                      <p>{m.desc}</p>
                      {m.sections.length > 0 && (
                        <div class="secs">
                          {m.sections.slice(0, SHOWN).map((s) => (
                            <a href={`${m.file}#${s.h}`}>{s.t}</a>
                          ))}
                          {m.sections.length > SHOWN && (
                            <>
                              <span class="rest" style="display:none">
                                {m.sections.slice(SHOWN).map((s) => (
                                  <a href={`${m.file}#${s.h}`}>{s.t}</a>
                                ))}
                              </span>
                              <button type="button" data-more>+{m.sections.length - SHOWN} weitere</button>
                            </>
                          )}
                        </div>
                      )}
                      <div class="foot">
                        <span>{m.sections.length ? `${m.sections.length} Abschnitte` : "Einzelseite"}</span>
                        <span>{fmtDate(m.updated)}</span>
                        <a class="open" href={m.file}>öffnen →</a>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>

          <section class="blk">
            <div class="wrap">
              <div class="eyebrow">Andere Hubs</div>
              <div class="hubgrid">
                {hubs.filter((h) => h.id !== hub.id).map((h) => <HubCard hub={h} />)}
              </div>
            </div>
          </section>
        </main>

        <script is:inline>
          /* Abschnitts-Chips aufklappen */
          document.addEventListener("click", function (e) {
            var b = e.target.closest("[data-more]");
            if (!b) return;
            var rest = b.parentElement.querySelector(".rest");
            if (rest) rest.style.display = "contents";
            b.remove();
          });
        </script>
      </>
    )
  }

  {
    /* =============================== MODUL-SEITE =============================== */
    mod && (
      <div class="mlay">
        <aside class="msd" id="msd">
          <div class="msd-head">
            <span class="ic">{mod.icon}</span>
            <div>
              <div class="nm">{mod.name}</div>
              <div class="kd">{mod.kind} · {hub.icon} {hub.name}</div>
            </div>
          </div>
          <nav class="msd-nav" id="msdNav" aria-label="Abschnitte">
            {navGroups.map((g, gi) => (
              <>
                {g.label && <div class="msd-gl">{g.label}</div>}
                {g.hashes.map((h: string, i: number) => (
                  <a href={`#${h}`} data-h={h} class={gi === 0 && i === 0 ? "on" : undefined}>{secTitle(h)}</a>
                ))}
              </>
            ))}
          </nav>
          <div class="msd-foot">
            <a href={hub.file}>{hub.icon} {hub.name}-Hub</a>
            {related.map((m) => (
              <a href={m.file}>{m.icon} {m.name}</a>
            ))}
          </div>
        </aside>
        <div class="mscrim" id="mscrim"></div>

        <main class="mmain">
          <div class="mtop" id="mtop">
            <button id="mburger" type="button" aria-label="Abschnitte öffnen">☰</button>
            <span class="tt">{mod.name}</span>
            <button class="ts" type="button" data-hbx-search>🔍 Suchen</button>
          </div>

          <header class="mhead">
            <h1>{mod.name}</h1>
            <p>{mod.desc}</p>
          </header>

          <div class={`mcontent mx-${mod.id}${["koch-basics","steak","cuts-atlas"].includes(mod.id) ? " mx-sys" : ""}`} data-pagefind-body data-pagefind-meta={`title:${mod.name}`}>
            {mod.sections.map((s) => {
              const C = secComp(mod.id, s.h);
              return (
                <section class="msec" id={s.h}>
                  <h2 class="msec-t">{s.t}</h2>
                  <C />
                </section>
              );
            })}
          </div>
          <script is:inline type="application/json" id="mrouterCfg" set:html={routerCfg} />
          {pageScript && <script is:inline defer src={pageScript} />}

          <div class="hbx-foot">
            <div class="hd">Weiter im Hub {hub.name}</div>
            <div class="row">
              <a class="up" href={hub.file}>
                <span>{hub.icon}</span><span>Alle {hub.modules.length} Module im {hub.name}-Hub</span>
              </a>
              {hub.modules.filter((m) => m.id !== mod.id).map((m) => (
                <a href={m.file}><span>{m.icon}</span><span>{m.name}</span></a>
              ))}
            </div>
            {related.filter((m) => m.hub.id !== hub.id).length > 0 && (
              <>
                <div class="hd">Verwandt in anderen Hubs</div>
                <div class="row">
                  {related.filter((m) => m.hub.id !== hub.id).map((m) => (
                    <a href={m.file}>
                      <span>{m.icon}</span><span>{m.name}</span>
                      <span class="hx">{m.hub.icon} {m.hub.name}</span>
                    </a>
                  ))}
                </div>
              </>
            )}
          </div>
        </main>
      </div>

      <script is:inline>
        /* ---- Abschnitts-Router ----------------------------------------------
           Ein Abschnitt sichtbar, per #hash adressiert. Dazu: Alias-Hashes
           alter Anker, Überschriften-Subnav mit Scrollspy unter dem aktiven
           Eintrag, Sprung öffnet Faltabschnitte (window.__openSection). */
        (function () {
          var nav = document.getElementById("msdNav");
          if (!nav) return;
          var cfgEl = document.getElementById("mrouterCfg");
          var ALIAS = {};
          try { ALIAS = (JSON.parse(cfgEl.textContent) || {}).alias || {}; } catch (e) {}

          var secs = Array.prototype.slice.call(document.querySelectorAll(".msec"));
          var links = Array.prototype.slice.call(nav.querySelectorAll("a[data-h]"));
          var KEYS = secs.map(function (s) { return s.id; });

          /* Ein Hash kann Abschnitt, Alias oder Überschriften-Anker sein. */
          function resolve(raw) {
            var h = ALIAS[raw] || raw;
            if (KEYS.indexOf(h) >= 0) return { sec: h, head: null };
            var i = h.indexOf("--");
            if (i > 0 && KEYS.indexOf(h.slice(0, i)) >= 0) return { sec: h.slice(0, i), head: h };
            var el = h && document.getElementById(h);
            var host = el && el.closest && el.closest(".msec");
            if (host) return { sec: host.id, head: h };
            return { sec: KEYS[0], head: null };
          }

          function slug(s) {
            return s.toLowerCase().replace(/[^a-z0-9äöüß]+/g, "-").replace(/^-|-$/g, "").slice(0, 40);
          }
          /* h3/h4 in Karten & Co. sind Beschriftungen, keine Gliederung. */
          var HDECO = ".card, .gb-col, .sym, .grid2 > div, .rule, .calc, .acc, .def-grid, .spec-card, .step";
          function headings(sec) {
            var hs = Array.prototype.slice.call(sec.querySelectorAll("h2:not(.msec-t),h3,h4")).filter(function (h) {
              return !h.closest(HDECO);
            });
            if (hs.length < 2) return [];
            hs.forEach(function (h, i) {
              if (!h.id) h.id = sec.id + "--" + (slug(h.textContent) || "h" + i);
            });
            return hs;
          }

          var spy = null, spyLock = 0;
          function markSub(id) {
            nav.querySelectorAll(".msd-sub a").forEach(function (a) {
              a.classList.toggle("on", a.dataset.hh === id);
            });
          }
          function buildSub(h) {
            nav.querySelectorAll(".msd-sub").forEach(function (b) { b.remove(); });
            if (spy) { spy.disconnect(); spy = null; }
            var lk = links.filter(function (a) { return a.dataset.h === h; })[0];
            var sec = document.getElementById(h);
            if (!lk || !sec) return;
            var hs = headings(sec);
            if (!hs.length) return;
            var box = document.createElement("div");
            box.className = "msd-sub";
            hs.forEach(function (hd) {
              var a = document.createElement("a");
              a.href = "#" + hd.id;
              a.textContent = hd.textContent.trim();
              a.dataset.hh = hd.id;
              a.className = "lv" + hd.tagName.charAt(1);
              box.appendChild(a);
            });
            lk.after(box);
            spy = new IntersectionObserver(function (es) {
              if (Date.now() < spyLock) return;
              es.forEach(function (en) { if (en.isIntersecting) markSub(en.target.id); });
            }, { rootMargin: "-30% 0px -60% 0px", threshold: 0 });
            hs.forEach(function (hd) { spy.observe(hd); });
          }

          function jumpTo(id) {
            spyLock = Date.now() + 1000;
            if (window.__openSection) window.__openSection(id);
            var el = document.getElementById(id);
            if (!el) return;
            markSub(id);
            el.scrollIntoView({ behavior: "smooth", block: "start" });
          }

          function show(h, opts) {
            opts = opts || {};
            secs.forEach(function (s) { s.classList.toggle("on", s.id === h); });
            links.forEach(function (a) { a.classList.toggle("on", a.dataset.h === h); });
            if (opts.push !== false && decodeURIComponent(location.hash.slice(1)) !== h) {
              history.replaceState(null, "", "#" + h);
            }
            var tt = document.querySelector("#mtop .tt");
            var lk = links.filter(function (a) { return a.dataset.h === h; })[0];
            if (tt && lk) tt.textContent = lk.textContent;
            buildSub(h);
          }

          function go(raw, push) {
            var r = resolve(decodeURIComponent(raw || ""));
            show(r.sec, { push: push });
            if (r.head) requestAnimationFrame(function () { jumpTo(r.head); });
            else window.scrollTo({ top: 0 });
          }

          window.addEventListener("hashchange", function () {
            go(location.hash.slice(1), false);
          });

          var first = resolve(decodeURIComponent(location.hash.slice(1)));
          show(first.sec, { push: false });
          /* Browser-Ankersprung beim Laden korrigieren; Ziel ggf. anfahren,
             sobald das Modul-Skript Folds und Tabellen aufgebaut hat. Der
             native Sprung kann nach unserem rAF feuern — deshalb zusätzlich
             nach load noch einmal geraderücken. */
          function settle() {
            if (first.head) jumpTo(first.head);
            else window.scrollTo(0, 0);
          }
          requestAnimationFrame(settle);
          window.addEventListener("load", function () { requestAnimationFrame(settle); });

          /* ---- Mobile Schublade ---- */
          var side = document.getElementById("msd");
          var scrim = document.getElementById("mscrim");
          function openSide() { side.classList.add("open"); scrim.classList.add("show"); }
          function closeSide() { side.classList.remove("open"); scrim.classList.remove("show"); }
          document.getElementById("mburger").addEventListener("click", openSide);
          scrim.addEventListener("click", closeSide);
          document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeSide(); });

          nav.addEventListener("click", function (e) {
            var a = e.target.closest("a");
            if (!a) return;
            e.preventDefault();
            if (a.dataset.hh) {
              /* Subnav: innerhalb des Abschnitts springen */
              history.replaceState(null, "", "#" + a.dataset.hh);
              jumpTo(a.dataset.hh);
            } else if (a.dataset.h) {
              show(a.dataset.h, { push: true });
              window.scrollTo({ top: 0 });
            }
            closeSide();
          });
        })();
      </script>
    )
  }
</Base>
