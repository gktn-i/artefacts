---
/* ============================================================================
   Eine dynamische Route für zwei Seitentypen:
     · Hub-Panels   (hub-werkstatt.html, hub-kueche.html, …)
     · native Module (koch-basics.html, …) — deren Inhalte liegen als
       src/content/<modul-id>/<abschnitt-hash>.astro

   Ein Modul gilt als „nativ", sobald sein Ordner unter src/content/ existiert.
   Der Build wacht darüber, dass Registry-Abschnitte und Content-Dateien
   deckungsgleich sind — läuft etwas auseinander, bricht er ab.
   ========================================================================== */
import Base from "../layouts/Base.astro";
import SectionBody from "../components/SectionBody.astro";
import { hubs, moduleById, hubById, relatedOf, fmtDate } from "../lib/registry.mjs";

export function getStaticPaths() {
  /* eager wie unten beim Rendern: dieselben Module einmal lazy und einmal
     statisch zu importieren, quittiert Vite mit einer Warnung pro Datei. */
  const files = import.meta.glob("../content/*/*.astro", { eager: true });
  const nativeIds = [...new Set(Object.keys(files).map((p) => p.split("/")[2]))];
  const paths = [];
  for (const h of hubs) {
    paths.push({ params: { slug: h.file.replace(/\.html$/, "") }, props: { type: "hub", id: h.id } });
  }
  for (const id of nativeIds) {
    const m = moduleById(id);
    if (!m) throw new Error(`src/content/${id}/ hat keinen Registry-Eintrag`);
    paths.push({ params: { slug: m.file.replace(/\.html$/, "") }, props: { type: "mod", id } });
  }
  return paths;
}

const { type, id } = Astro.props;
const hub = type === "hub" ? hubById(id) : moduleById(id).hub;
const mod = type === "mod" ? moduleById(id) : null;

/* Abschnitts-Komponenten laden und gegen die Registry prüfen. */
const secFiles = import.meta.glob("../content/*/*.astro", { eager: true });
const secComp = (mid, h) => {
  const f = secFiles[`../content/${mid}/${h}.astro`];
  if (!f) throw new Error(`Fehlender Abschnitt: src/content/${mid}/${h}.astro`);
  return f.default;
};
if (mod) {
  const have = Object.keys(secFiles)
    .filter((p) => p.split("/")[2] === mod.id)
    .map((p) => p.split("/")[3].replace(/\.astro$/, ""));
  const want = mod.sections.map((s) => s.h);
  for (const h of have) {
    if (!want.includes(h)) throw new Error(`src/content/${mod.id}/${h}.astro fehlt in der Registry`);
  }
}

const related = relatedOf(id).filter((m) => !mod || m.id !== mod.id);
const title = mod ? `${mod.name} · ${hub.name} · Artefakte` : `${hub.name} · Artefakte`;
const desc = mod ? mod.desc : `${hub.name} — ${hub.desc}`;

/* Zusatz-Skripte des Moduls (Rechner, Tabellen-Builder, Folds …). */
/* Werkstatt-Module, die das gemeinsame Technik-Design und -Skript mitbenutzen.
   Sie bleiben im Werkstatt-Hub, sehen aber aus wie der Mechatronik-Hub. */
const MECHA_MODULES = new Set(["dremel", "schmiermittel", "druck", "messer", "meshtastic", "weltempfaenger", "holzarbeiten", "handarbeit", "tischlerregeln"]);

const PAGE_SCRIPTS: Record<string, string | string[]> = {
  loeten: "/assets/mod-loeten.js",
  "elektronik-101": "/assets/mod-elektronik.js",
  dremel: "/assets/mod-mecha.js",
  homeserver: "/assets/mod-homeserver.js",
  schmiermittel: "/assets/mod-mecha.js",
  /* 3D-Druck: gemeinsames Technik-Skript + Rentabilitäts-Simulator. */
  druck: ["/assets/mod-mecha.js", "/assets/mod-druck.js"],
  "lumix-s1ii": "/assets/mod-lumix-s1ii.js",
  /* Der Mechatronik-Hub teilt sich ein Modul-Skript — es initialisiert
     nur die Bausteine, die auf der jeweiligen Seite auch vorkommen. */
  mechanik: "/assets/mod-mecha.js",
  elektrotechnik: "/assets/mod-mecha.js",
  analogtechnik: "/assets/mod-mecha.js",
  digitaltechnik: "/assets/mod-mecha.js",
  informationstechnik: "/assets/mod-mecha.js",
  embedded: "/assets/mod-mecha.js",
  "regelung-antriebe": "/assets/mod-mecha.js",
  automatisierung: "/assets/mod-mecha.js",
  "pcb-design": "/assets/mod-mecha.js",
  lernpfad: "/assets/mod-mecha.js",
  "mecha-referenz": "/assets/mod-mecha.js",
  "fpv-drohnen": "/assets/mod-mecha.js",
  /* Messer-Hub: gleiches Technik-Design und -Skript. */
  messer: "/assets/mod-mecha.js",
  /* Funk-Hub: gleiches Technik-Design und -Skript (Airtime-, Antennen-, Akku-Rechner). */
  meshtastic: "/assets/mod-mecha.js",
  weltempfaenger: "/assets/mod-mecha.js",
  /* Holzwerken-Hub: gleiches Technik-Design und -Skript (Tabellen, Falten, Projektfilter). */
  holzarbeiten: "/assets/mod-mecha.js",
  handarbeit: "/assets/mod-mecha.js",
  tischlerregeln: "/assets/mod-mecha.js",
};
const pageScripts = mod ? [PAGE_SCRIPTS[mod.id] || []].flat() : [];
const routerCfg = mod ? JSON.stringify({ alias: mod.alias || {} }) : "{}";
const pad = (n: number) => String(n + 1).padStart(2, "0");
---

<Base title={title} description={desc} hub={hub} mod={mod}>
  {
    /* ================================ HUB-PANEL ================================ */
    !mod && (
      <div class="panel">
        <header class="panel-head">
          <span class="badge" aria-hidden="true">{hub.icon}</span>
          <h1>{hub.name}</h1>
          <div class="tagline">{hub.tagline}</div>
        </header>
        <p class="desc">{hub.desc}</p>

        <div class="statline">
          <span><b>{hub.modules.length}</b> Module</span>
          <span><b>{hub.sectionCount}</b> Abschnitte</span>
          <span><b>{hub.areas.length}</b> Bereiche</span>
          <span>zuletzt <b>{fmtDate(hub.updated)}</b></span>
        </div>

        <nav class="areajump" aria-label="Bereiche">
          {hub.areas.map((ar) => (
            <a href={`#a-${ar.id}`}>{ar.name} <span class="ct">{ar.modules.length}</span></a>
          ))}
        </nav>

        {hub.tasks.length > 0 && (
          <section class="tasks" id="schnellzugriff" aria-label="Schnellzugriff nach Aufgabe">
            <div class="rowlabel">
              <h2>Schnellzugriff</h2>
              <span class="n">nach Aufgabe, quer durch die Module</span>
              <span class="ln"></span>
            </div>
            <div class="taskgrid">
              {hub.tasks.map((t) => (
                <article class="task" id={`t-${t.id}`}>
                  <header>
                    <span class="ic" aria-hidden="true">{t.icon}</span>
                    <h3>{t.t}</h3>
                  </header>
                  <p class="d">{t.d}</p>
                  <ul>
                    {t.items.map((it) => (
                      <li>
                        <a href={it.href}>{it.label}</a>
                        <span class="md">{it.cross ? `${it.mod.hub.icon} ` : ""}{it.mod.name}</span>
                      </li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </section>
        )}

        {hub.areas.map((ar) => (
          <section class="areasec" id={`a-${ar.id}`}>
            <div class="ah">
              <h2>{ar.name}</h2>
              <span class="ct">{ar.modules.length} Module</span>
              <span class="ln"></span>
            </div>
            <p class="d">{ar.desc}</p>
            <div class="modrows">
              {ar.modules.map((m) => (
                <article class="modrow">
                  <span class="ic" aria-hidden="true">{m.icon}</span>
                  <div class="hd">
                    <a class="name" href={m.file}>{m.name}</a>
                    <span class="kind">{m.kind}</span>
                  </div>
                  <div class="meta">
                    {m.sections.length ? `${m.sections.length} Abschnitte` : "Einzelseite"}<br />
                    {fmtDate(m.updated)} <span class="ar">→</span>
                  </div>
                  <p class="ds">{m.desc}</p>
                  {m.sections.length > 0 && (
                    <details class="secfold">
                      <summary>
                        <svg class="chev" width="8" height="8" viewBox="0 0 10 10" aria-hidden="true">
                          <path d="M3 1.5 7 5l-4 3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                        Abschnitte zeigen
                      </summary>
                      <div class="chips">
                        {m.sections.map((s) => (
                          <a href={`${m.file}#${s.h}`}>{s.t}</a>
                        ))}
                      </div>
                    </details>
                  )}
                </article>
              ))}
            </div>
          </section>
        ))}

        <div class="rowlabel" style="margin-top:40px">
          <h2>Andere Hubs</h2>
          <span class="ln"></span>
        </div>
        <div class="hubstrip">
          {hubs.filter((h) => h.id !== hub.id).map((h) => (
            <a class="hx" href={h.file} style={`--hcl:${h.accent.l};--hcd:${h.accent.d}`}>
              <span aria-hidden="true">{h.icon}</span>
              <span>{h.name}</span>
              <span class="ct">{h.modules.length} Module</span>
            </a>
          ))}
        </div>
      </div>
    )
  }

  {
    /* =============================== MODUL-SEITE =============================== */
    mod && (
      <div class="work">
        <header class="work-head">
          <span class="badge" aria-hidden="true">{mod.icon}</span>
          <h1>{mod.name}</h1>
          <div class="sub">
            <span>{mod.kind}</span>
            <a href={hub.file}>{hub.icon} {hub.name}</a>
            <span>{mod.sections.length} Abschnitte</span>
            <span>Stand {fmtDate(mod.updated)}</span>
          </div>
          <p class="desc">{mod.desc}</p>
        </header>

        <div class={`mcontent mx-${mod.id}${["koch-basics","kuechenmesser","steak","cuts-atlas"].includes(mod.id) ? " mx-sys" : ""}${hub.id === "mechatronik" || MECHA_MODULES.has(mod.id) ? " mx-mecha" : ""}`} data-pagefind-body data-pagefind-meta={`title:${mod.name}`}>
          {mod.sections.map((s, i) => {
            const C = secComp(mod.id, s.h);
            const prev = mod.sections[i - 1];
            const next = mod.sections[i + 1];
            /* Die ID sitzt auf der Überschrift, nicht auf <section>: nur
               Überschriften mit ID werden in Pagefind zu Sprungzielen. */
            return (
              <section class="msec" data-sec={s.h} aria-labelledby={s.h}>
                <h2 class="msec-t" id={s.h}><span class="no" data-pagefind-ignore>{pad(i)} / {pad(mod.sections.length - 1)}</span>{s.t}</h2>
                <SectionBody sec={s.h}><C /></SectionBody>
                <nav class="pager" data-pagefind-ignore aria-label="Abschnitte blättern">
                  {prev ? (
                    <a class="prev" href={`#${prev.h}`}><span class="lb">← Vorheriger Abschnitt</span><span class="tt">{prev.t}</span></a>
                  ) : (
                    <span class="ghost"></span>
                  )}
                  {next ? (
                    <a class="next" href={`#${next.h}`}><span class="lb">Nächster Abschnitt →</span><span class="tt">{next.t}</span></a>
                  ) : (
                    <span class="ghost"></span>
                  )}
                </nav>
              </section>
            );
          })}
        </div>
        <script is:inline type="application/json" id="mrouterCfg" set:html={routerCfg} />
        <div class="sr-only" id="secLive" aria-live="polite"></div>
        {pageScripts.map((src) => (
          <script is:inline defer src={src} />
        ))}

        <div class="modfoot" data-pagefind-ignore>
          <div class="hd">Weiter im Hub {hub.name}</div>
          <div class="row">
            <a class="up" href={hub.file}>
              <span aria-hidden="true">{hub.icon}</span><span>Alle {hub.modules.length} Module im {hub.name}-Hub</span>
            </a>
            {hub.modules.filter((m) => m.id !== mod.id).map((m) => (
              <a href={m.file}><span aria-hidden="true">{m.icon}</span><span>{m.name}</span></a>
            ))}
          </div>
          {related.filter((m) => m.hub.id !== hub.id).length > 0 && (
            <>
              <div class="hd">Verwandt in anderen Hubs</div>
              <div class="row">
                {related.filter((m) => m.hub.id !== hub.id).map((m) => (
                  <a href={m.file}>
                    <span aria-hidden="true">{m.icon}</span><span>{m.name}</span>
                    <span class="hx-tag">{m.hub.icon} {m.hub.name}</span>
                  </a>
                ))}
              </div>
            </>
          )}
        </div>
      </div>

      <script is:inline>
        /* ---- Abschnitts-Router ----------------------------------------------
           Ein Abschnitt sichtbar, per #hash adressiert. Die Abschnitts-Links
           leben in der Rail (#secNav). Dazu: Alias-Hashes alter Anker,
           Überschriften-Subnav mit Scrollspy unter dem aktiven Eintrag,
           Brotkrumen-Update in der Topbar, Sprung öffnet Faltabschnitte
           (window.__openSection).
           Jeder Abschnittswechsel ist ein eigener Verlaufseintrag: Zurück
           führt zum vorigen Abschnitt, Strg/⌘-Klick öffnet einen neuen Tab. */
        (function () {
          var nav = document.getElementById("secNav");
          if (!nav) return;
          var cfgEl = document.getElementById("mrouterCfg");
          var ALIAS = {};
          try { ALIAS = (JSON.parse(cfgEl.textContent) || {}).alias || {}; } catch (e) {}

          var secs = Array.prototype.slice.call(document.querySelectorAll(".msec"));
          var links = Array.prototype.slice.call(nav.querySelectorAll("a[data-h]"));
          var KEYS = secs.map(function (s) { return s.dataset.sec; });
          var crumb = document.getElementById("crumbSec");
          var live = document.getElementById("secLive");
          var tree = nav.closest(".tree");
          var calm = matchMedia("(prefers-reduced-motion: reduce)");
          var cur = null;

          /* Kaputte %-Folgen im Hash dürfen den Router nicht umwerfen. */
          function dec(s) {
            try { return decodeURIComponent(s); } catch (e) { return s; }
          }
          function linkFor(h) {
            return links.filter(function (a) { return a.dataset.h === h; })[0] || null;
          }

          /* Ein Hash kann Abschnitt, Alias oder Überschriften-Anker sein. */
          function resolve(raw) {
            var h = ALIAS[raw] || raw;
            if (KEYS.indexOf(h) >= 0) return { sec: h, head: null };
            var i = h.indexOf("--");
            if (i > 0 && KEYS.indexOf(h.slice(0, i)) >= 0) return { sec: h.slice(0, i), head: h };
            var el = h && document.getElementById(h);
            var host = el && el.closest && el.closest(".msec");
            if (host) return { sec: host.dataset.sec, head: h };
            return { sec: KEYS[0], head: null };
          }

          /* Gleiches Schema wie src/lib/anchors.mjs — die Überschriften haben
             ihre IDs schon aus dem Build, das hier greift nur für Nachzügler. */
          function slug(s) {
            return s.toLowerCase().replace(/[^a-z0-9äöüß]+/g, "-").replace(/^-|-$/g, "").slice(0, 40);
          }
          /* h3/h4 in Karten & Co. sind Beschriftungen, keine Gliederung. */
          var HDECO = ".card, .gb-col, .sym, .grid2 > div, .rule, .calc, .acc, .def-grid, .spec-card, .step, "
            + ".tip, .warn, .stop, .kpi, .map a, .pstep, .srcs, .gitem, .fbox, figure, .grid > div, .grid3 > div, .pager";
          function headings(sec) {
            var hs = Array.prototype.slice.call(sec.querySelectorAll("h2:not(.msec-t),h3,h4")).filter(function (h) {
              return !h.closest(HDECO);
            });
            if (hs.length < 2) return [];
            hs.forEach(function (h, i) {
              if (h.id) return;
              var id = sec.dataset.sec + "--" + (slug(h.textContent) || "h" + i), base = id, k = 2;
              while (document.getElementById(id)) id = base + "-" + k++;
              h.id = id;
            });
            return hs;
          }

          /* Aktiven Eintrag in der Rail sichtbar halten — es scrollt nur die
             Rail, nie die Seite. */
          function reveal(el) {
            if (!tree || !el) return;
            var t = tree.getBoundingClientRect(), r = el.getBoundingClientRect();
            if (r.top < t.top + 40 || r.bottom > t.bottom - 16) tree.scrollTop += r.top - t.top - t.height / 3;
          }

          /* Fokus auf ein Ziel setzen, ohne zu scrollen (Überschriften sind
             von Haus aus nicht fokussierbar). */
          function focusOn(el) {
            if (!el) return;
            if (!el.hasAttribute("tabindex")) el.setAttribute("tabindex", "-1");
            el.focus({ preventScroll: true });
          }

          /* Neuer Verlaufseintrag für einen Abschnitt. Vorher merkt sich der
             alte Eintrag die Scrollposition — Zurück landet wieder dort. */
          function push(hash) {
            try { history.replaceState({ y: window.scrollY }, ""); } catch (e) {}
            history.pushState(null, "", hash);
          }

          var spy = null, spyLock = 0;
          function markSub(id) {
            nav.querySelectorAll(".sub a").forEach(function (a) {
              a.classList.toggle("on", a.dataset.hh === id);
            });
          }
          function buildSub(h) {
            nav.querySelectorAll(".sub").forEach(function (b) { b.remove(); });
            if (spy) { spy.disconnect(); spy = null; }
            var lk = linkFor(h);
            var sec = secs[KEYS.indexOf(h)];
            if (!lk || !sec) return;
            var hs = headings(sec);
            if (!hs.length) return;
            var box = document.createElement("div");
            box.className = "sub";
            hs.forEach(function (hd) {
              var a = document.createElement("a");
              a.href = "#" + hd.id;
              a.textContent = hd.textContent.trim();
              a.dataset.hh = hd.id;
              a.className = "lv" + hd.tagName.charAt(1);
              box.appendChild(a);
            });
            lk.after(box);
            spy = new IntersectionObserver(function (es) {
              if (Date.now() < spyLock) return;
              es.forEach(function (en) { if (en.isIntersecting) markSub(en.target.id); });
            }, { rootMargin: "-30% 0px -60% 0px", threshold: 0 });
            hs.forEach(function (hd) { spy.observe(hd); });
          }

          function jumpTo(id, instant) {
            spyLock = Date.now() + 1000;
            if (window.__openSection) window.__openSection(id);
            var el = document.getElementById(id);
            if (!el) return;
            markSub(id);
            el.scrollIntoView({ behavior: instant || calm.matches ? "auto" : "smooth", block: "start" });
          }

          function show(h, opts) {
            opts = opts || {};
            var prev = cur;
            cur = h;
            secs.forEach(function (s) { s.classList.toggle("on", s.dataset.sec === h); });
            links.forEach(function (a) {
              var on = a.dataset.h === h;
              a.classList.toggle("on", on);
              if (on) a.setAttribute("aria-current", "true");
              else a.removeAttribute("aria-current");
            });
            if (opts.push && dec(location.hash.slice(1)) !== h) push("#" + h);
            var lk = linkFor(h);
            if (crumb && lk) {
              crumb.innerHTML = "";
              var sep = document.createElement("span");
              sep.className = "sep";
              sep.setAttribute("aria-hidden", "true");
              sep.textContent = "/";
              var sc = document.createElement("span");
              sc.className = "sec";
              sc.textContent = lk.textContent.trim();
              crumb.appendChild(sep);
              crumb.appendChild(sc);
            }
            buildSub(h);
            if (opts.reveal !== false) reveal(lk);
            /* Screenreader erfahren vom Wechsel, auch wenn der Fokus in der Rail bleibt. */
            if (live && prev && prev !== h && lk) live.textContent = "Abschnitt: " + lk.textContent.trim();
          }

          function go(raw, y) {
            var r = resolve(dec(raw || ""));
            show(r.sec);
            if (y != null) requestAnimationFrame(function () { window.scrollTo(0, y); });
            else if (r.head) requestAnimationFrame(function () { jumpTo(r.head); });
            else window.scrollTo({ top: 0 });
          }

          /* Zurück/Vor, Links ohne Router, Adresse von Hand geändert. */
          window.addEventListener("hashchange", function () {
            var st = history.state;
            go(location.hash.slice(1), st && typeof st.y === "number" ? st.y : null);
          });

          /* Links im Inhalt, die in einen anderen Abschnitt derselben Seite
             führen (Blätterleiste, Querverweise): Der angeklickte Link
             verschwindet mit seinem Abschnitt — der Fokus rückt deshalb ans
             Ziel, statt im Nichts zu landen. */
          var content = document.querySelector(".mcontent");
          if (content) content.addEventListener("click", function (e) {
            var a = e.target.closest && e.target.closest("a[href]");
            if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            if (a.origin !== location.origin || a.pathname !== location.pathname || a.hash.length < 2) return;
            var r = resolve(dec(a.hash.slice(1)));
            if (r.sec === cur) return; /* Sprung im selben Abschnitt: macht der Browser */
            e.preventDefault();
            push(a.hash);
            go(a.hash.slice(1));
            focusOn(document.getElementById(r.head || r.sec));
          });

          var first = resolve(dec(location.hash.slice(1)));
          show(first.sec);
          /* Browser-Ankersprung beim Laden korrigieren; Ziel ggf. anfahren,
             sobald das Modul-Skript Folds und Tabellen aufgebaut hat. Der
             native Sprung kann nach unserem rAF feuern — deshalb zusätzlich
             nach load noch einmal geraderücken. Aber nie gegen den Leser:
             Hat er schon selbst gescrollt, oder stellt der Browser nach
             Neuladen/Zurück die alte Position wieder her, bleibt sie. */
          var touched = false;
          ["wheel", "touchstart", "keydown", "mousedown"].forEach(function (t) {
            window.addEventListener(t, function () { touched = true; }, { once: true, passive: true, capture: true });
          });
          var navEntry = performance.getEntriesByType ? performance.getEntriesByType("navigation")[0] : null;
          var restored = !!navEntry && (navEntry.type === "back_forward" || navEntry.type === "reload");
          function settle() {
            if (touched || restored) return;
            if (first.head) jumpTo(first.head, true);
            else window.scrollTo(0, 0);
          }
          requestAnimationFrame(settle);
          window.addEventListener("load", function () { requestAnimationFrame(settle); });

          nav.addEventListener("click", function (e) {
            var a = e.target.closest("a");
            /* Strg/⌘/Umschalt/Mitte: der Browser öffnet Tab oder Fenster. */
            if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            if (a.dataset.hh) {
              /* Subnav: innerhalb des Abschnitts springen */
              e.preventDefault();
              history.replaceState(null, "", "#" + a.dataset.hh);
              jumpTo(a.dataset.hh);
            } else if (a.dataset.h) {
              e.preventDefault();
              show(a.dataset.h, { push: true, reveal: false });
              window.scrollTo({ top: 0 });
            }
          });
        })();
      </script>
    )
  }
</Base>
