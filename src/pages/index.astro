---
/* ============================================================================
   Startseite: die Kommandozentrale der Bibliothek.
   Kein Blockstapel — ein Schaltpult: Suche, Hub-Kacheln, daneben das
   komplette Modulverzeichnis und die letzten Aktualisierungen.
   Alles serverseitig aus src/data/registry.json gerendert.
   ========================================================================== */
import Base from "../layouts/Base.astro";
import { hubs, modules, sectionCount, lastUpdated, fmtDate } from "../lib/registry.mjs";

const recent = modules
  .slice()
  .sort((a, b) => (b.updated || "").localeCompare(a.updated || ""))
  .slice(0, 6);
---

<Base
  title="Artefakte · Werkbank"
  description="Nachschlagewerke für Werkstatt, Mechatronik, Küche, Homelab, Foto und Messer — ein Hub für alles, mit Volltextsuche über alle Module und Abschnitte."
>
  <div class="dash">
    <div class="dash-kicker">bib.gktn.dev — selbstgebaute Nachschlagewerke</div>
    <h1>Die Werkbank für alles, was man zweimal nachschlägt.</h1>
    <p class="lead">
      Sechs Hubs — <b>Werkstatt</b>, <b>Mechatronik</b>, <b>Küche</b>, <b>Homelab</b>,
      <b>Foto&nbsp;&amp;&nbsp;Video</b> und <b>Messer</b> — mit {modules.length} Modulen und {sectionCount} Abschnitten.
      Alles liegt in der Leiste links; die Suche kennt jeden Abschnitt und den kompletten Volltext.
    </p>

    <button class="cmdbar" type="button" data-pal>
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
      </svg>
      <span class="t">Alles durchsuchen — Module, Abschnitte, Volltext …</span>
      <kbd>⌘K</kbd>
    </button>

    <div class="statline">
      <span><b>{hubs.length}</b> Hubs</span>
      <span><b>{modules.length}</b> Module</span>
      <span><b>{sectionCount}</b> Abschnitte</span>
      <span>zuletzt <b>{fmtDate(lastUpdated)}</b></span>
    </div>

    <div class="rowlabel">
      <h2>Hubs</h2>
      <span class="n">{hubs.length}</span>
      <span class="ln"></span>
    </div>
    <div class="tiles">
      {hubs.map((h) => (
        <a class="tile hx" href={h.file} style={`--hcl:${h.accent.l};--hcd:${h.accent.d}`}>
          <span class="ic" aria-hidden="true">{h.icon}</span>
          <h3>{h.name}</h3>
          <span class="tag">{h.tagline}</span>
          <span class="meta">
            <span>{h.modules.length} Module</span>
            <span>{h.sectionCount} Abschn.</span>
            <span class="go" aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>

    <div class="board">
      <section>
        <div class="rowlabel">
          <h2>Verzeichnis</h2>
          <span class="n">{modules.length} Module</span>
          <span class="ln"></span>
        </div>
        {hubs.map((h) => (
          <div class="dirgroup hx" style={`--hcl:${h.accent.l};--hcd:${h.accent.d}`}>
            <div class="gh">
              <span class="dot" aria-hidden="true"></span>
              <a href={h.file}>{h.name}</a>
              <span class="ct">{h.modules.length} Module · {h.sectionCount} Abschnitte</span>
            </div>
            <ul>
              {h.modules.map((m) => (
                <li>
                  <a href={m.file}>
                    <span>{m.icon} {m.name}</span>
                    <span class="ct">{m.sections.length || "–"}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>

      <section>
        <div class="rowlabel">
          <h2>Zuletzt aktualisiert</h2>
          <span class="ln"></span>
        </div>
        <div class="recent-list">
          {recent.map((m) => (
            <a class="recent-row hx" href={m.file} style={`--hcl:${m.hub.accent.l};--hcd:${m.hub.accent.d}`}>
              <span class="dt">{fmtDate(m.updated)}</span>
              <span class="nm">{m.icon} {m.name}</span>
              <span class="hb">{m.hub.name} · {m.area.name}</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</Base>
