---
/* ============================================================================
   Grundgerüst jeder Seite: die Werkbank-Shell.
   Links die Navigations-Rail (alle Hubs → Module → Abschnitte), oben die
   Topbar mit Brotkrumen und Suche, dazwischen der Inhalt. Die Shell ist auf
   jeder Seite identisch — die Bibliothek fühlt sich wie EIN Ort an.
   ========================================================================== */
import Rail from "../components/Rail.astro";
import Topbar from "../components/Topbar.astro";
import "../styles/app.css";

interface Props {
  title: string;
  description: string;
  hub?: any; /* Hub-Objekt aus lib/registry — färbt Akzent + Brotkrumen */
  mod?: any; /* Modul-Objekt, wenn die Seite ein Modul ist */
}
const { title, description, hub, mod } = Astro.props;

const accent = hub ? hub.accent : { l: "#0e7c8c", d: "#4fb9c9" };
const accCss =
  `html[data-acc]{--c:${accent.l}}` +
  `html[data-acc][data-hbx-theme="dark"]{--c:${accent.d}}` +
  `@media (prefers-color-scheme: dark){html[data-acc]:not([data-hbx-theme="light"]){--c:${accent.d}}}`;
---

<!doctype html>
<html lang="de" class="no-js" data-acc>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:inline set:html={accCss}></style>
    <script is:inline>
      /* Theme vor dem ersten Paint setzen + no-js lösen.
         Reihenfolge: gespeicherte Wahl (hbx-theme: light | dark) → System.
         window.__theme() liest/setzt den Modus (light | dark | system);
         der Schalter in der Topbar hängt daran. */
      (function () {
        var d = document.documentElement;
        d.classList.remove("no-js");
        var KEY = "hbx-theme";
        var q = matchMedia("(prefers-color-scheme: dark)");
        function stored() {
          try { var v = localStorage.getItem(KEY); return v === "light" || v === "dark" ? v : null; } catch (e) { return null; }
        }
        function apply() {
          var s = stored();
          d.setAttribute("data-hbx-theme", s || (q.matches ? "dark" : "light"));
          d.setAttribute("data-hbx-mode", s || "system");
        }
        window.__theme = function (mode) {
          if (mode === undefined) return d.getAttribute("data-hbx-mode") || "system";
          try {
            if (mode === "light" || mode === "dark") localStorage.setItem(KEY, mode);
            else localStorage.removeItem(KEY);
          } catch (e) {}
          apply();
          return mode;
        };
        apply();
        if (q.addEventListener) q.addEventListener("change", apply);
      })();
    </script>
    <script is:inline defer src="/assets/registry.js"></script>
    <script is:inline defer src="/assets/palette.js"></script>
  </head>
  <body>
    <a class="skip" href="#content">Zum Inhalt springen</a>
    <div class="shell">
      <Rail hub={hub} mod={mod} />
      <div class="maincol">
        <Topbar hub={hub} mod={mod} />
        <div id="content">
          <slot />
        </div>
        <footer class="site">
          <div class="inner">
            <span>Artefakte — Nachschlagewerke für Werkstatt, Mechatronik, Küche, Homelab, Foto, Messer und Funk.</span>
            <span><a href="index.html">Übersicht</a> · Struktur in <code>src/data/registry.json</code></span>
          </div>
        </footer>
      </div>
    </div>

    <button class="totop" id="totop" type="button" title="Nach oben" aria-label="Nach oben">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7"></path>
      </svg>
    </button>

    <script>
      /* Theme-Schalter: System → Hell → Dunkel → System. */
      const tbTheme = document.getElementById("tbTheme");
      const themeTitles: Record<string, string> = {
        system: "Farbschema: System (klicken für Hell)",
        light: "Farbschema: Hell (klicken für Dunkel)",
        dark: "Farbschema: Dunkel (klicken für System)",
      };
      const paintTheme = () => {
        const m = (window as any).__theme();
        if (!tbTheme) return;
        tbTheme.setAttribute("data-mode", m);
        tbTheme.setAttribute("title", themeTitles[m]);
        tbTheme.setAttribute("aria-label", themeTitles[m]);
      };
      paintTheme();
      tbTheme?.addEventListener("click", () => {
        const m = (window as any).__theme();
        (window as any).__theme(m === "system" ? "light" : m === "light" ? "dark" : "system");
        paintTheme();
      });

      /* Lesefortschritt in der Topbar + Nach-oben-Knopf (nur auf langen Seiten). */
      const bar = document.querySelector<HTMLElement>(".readbar i");
      const totop = document.getElementById("totop")!;
      let ticking = false;
      const paintScroll = () => {
        ticking = false;
        const de = document.documentElement;
        const max = de.scrollHeight - de.clientHeight;
        const long = max > de.clientHeight * 0.6;
        de.classList.toggle("longpage", long);
        if (bar) bar.style.width = long && max > 0 ? Math.min(100, (window.scrollY / max) * 100) + "%" : "0";
        totop.classList.toggle("show", long && window.scrollY > 700);
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(paintScroll); } };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      window.addEventListener("hashchange", () => setTimeout(paintScroll, 350));
      new MutationObserver(onScroll).observe(document.getElementById("content")!, { childList: true, subtree: true, attributes: true, attributeFilter: ["class"] });
      paintScroll();
      totop.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));

      /* Schubladen-Verhalten der Rail auf schmalen Viewports. */
      const rail = document.getElementById("rail")!;
      const scrim = document.getElementById("scrim")!;
      const burger = document.getElementById("burger")!;
      const setOpen = (open: boolean) => {
        rail.classList.toggle("open", open);
        scrim.classList.toggle("show", open);
        burger.setAttribute("aria-expanded", String(open));
      };
      burger.addEventListener("click", () => setOpen(!rail.classList.contains("open")));
      scrim.addEventListener("click", () => setOpen(false));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && rail.classList.contains("open")) setOpen(false);
      });
      /* Navigieren aus der Schublade schließt sie. */
      rail.addEventListener("click", (e) => {
        const a = (e.target as HTMLElement).closest("a");
        if (a && window.innerWidth <= 1020) setOpen(false);
      });
    </script>
  </body>
</html>
