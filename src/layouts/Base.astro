---
/* ============================================================================
   Grundgerüst jeder Seite: die Werkbank-Shell.
   Links die Navigations-Rail (alle Hubs → Module → Abschnitte), oben die
   Topbar mit Brotkrumen und Suche, dazwischen der Inhalt. Die Shell ist auf
   jeder Seite identisch — die Bibliothek fühlt sich wie EIN Ort an.
   ========================================================================== */
import Rail from "../components/Rail.astro";
import Topbar from "../components/Topbar.astro";
import "../styles/app.css";

interface Props {
  title: string;
  description: string;
  hub?: any; /* Hub-Objekt aus lib/registry — färbt Akzent + Brotkrumen */
  mod?: any; /* Modul-Objekt, wenn die Seite ein Modul ist */
}
const { title, description, hub, mod } = Astro.props;

const accent = hub ? hub.accent : { l: "#0e7c8c", d: "#38c6d9" };
const accCss =
  `html[data-acc]{--c:${accent.l}}` +
  `html[data-acc][data-hbx-theme="dark"]{--c:${accent.d}}` +
  `@media (prefers-color-scheme: dark){html[data-acc]:not([data-hbx-theme="light"]){--c:${accent.d}}}`;
---

<!doctype html>
<html lang="de" class="no-js" data-acc>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:inline set:html={accCss}></style>
    <script is:inline>
      /* Theme vor dem ersten Paint setzen (folgt dem System) + no-js lösen. */
      (function () {
        var d = document.documentElement;
        d.classList.remove("no-js");
        var q = matchMedia("(prefers-color-scheme: dark)");
        function a() {
          d.setAttribute("data-hbx-theme", q.matches ? "dark" : "light");
        }
        a();
        if (q.addEventListener) q.addEventListener("change", a);
      })();
    </script>
    <script is:inline defer src="/assets/registry.js"></script>
    <script is:inline defer src="/assets/palette.js"></script>
  </head>
  <body>
    <a class="skip" href="#content">Zum Inhalt springen</a>
    <div class="shell">
      <Rail hub={hub} mod={mod} />
      <div class="maincol">
        <Topbar hub={hub} mod={mod} />
        <div id="content">
          <slot />
        </div>
        <footer class="site">
          <div class="inner">
            <span>Artefakte — Nachschlagewerke für Werkstatt, Mechatronik, Küche, Homelab, Foto und Messer.</span>
            <span><a href="index.html">Übersicht</a> · Struktur in <code>src/data/registry.json</code></span>
          </div>
        </footer>
      </div>
    </div>

    <script>
      /* Schubladen-Verhalten der Rail auf schmalen Viewports. */
      const rail = document.getElementById("rail")!;
      const scrim = document.getElementById("scrim")!;
      const burger = document.getElementById("burger")!;
      const setOpen = (open: boolean) => {
        rail.classList.toggle("open", open);
        scrim.classList.toggle("show", open);
        burger.setAttribute("aria-expanded", String(open));
      };
      burger.addEventListener("click", () => setOpen(!rail.classList.contains("open")));
      scrim.addEventListener("click", () => setOpen(false));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && rail.classList.contains("open")) setOpen(false);
      });
      /* Navigieren aus der Schublade schließt sie. */
      rail.addEventListener("click", (e) => {
        const a = (e.target as HTMLElement).closest("a");
        if (a && window.innerWidth <= 1020) setOpen(false);
      });
    </script>
  </body>
</html>
