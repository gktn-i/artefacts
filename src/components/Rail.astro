---
/* ============================================================================
   Navigations-Rail — das Rückgrat der Werkbank.
   Kennt auf jeder Seite alle Hubs und Module; der aktive Hub ist aufgeklappt,
   beim aktiven Modul hängen dessen Abschnitte (samt Gruppen) direkt im Baum.
   Der Hash-Router der Modulseite bedient #secNav.
   Auf Mobilgeräten wird die Rail zur Schublade (Burger in der Topbar).
   ========================================================================== */
import { hubs, modules, sectionCount, lastUpdated, fmtDate } from "../lib/registry.mjs";

interface Props {
  hub?: any;
  mod?: any;
}
const { hub, mod } = Astro.props;

const secTitle = (m: any, h: string) => m.sections.find((s: any) => s.h === h)?.t || h;
const navGroups = (m: any) =>
  m.groups
    ? m.groups.map((g: any) => ({ label: g.l, hashes: g.sections }))
    : [{ label: null, hashes: m.sections.map((s: any) => s.h) }];
---

<aside class="rail" id="rail" aria-label="Bibliothek">
  <a class="brand" href="index.html" title="Zur Übersicht">
    <span class="glyph" aria-hidden="true">A</span>
    <span class="bt"><b>Artefakte</b><i>bib.gktn.dev</i></span>
  </a>

  <button class="railsearch" type="button" data-pal>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
    </svg>
    <span class="t">Suchen …</span>
    <kbd>⌘K</kbd>
  </button>

  <nav class="tree" aria-label="Hubs und Module">
    <div class="tree-label">Bibliothek</div>
    {
      hubs.map((h: any) => {
        const isHubHere = hub && hub.id === h.id;
        return (
          <details class={`hubnode hx${isHubHere ? " here" : ""}`} open={isHubHere} style={`--hcl:${h.accent.l};--hcd:${h.accent.d}`}>
            <summary>
              <span class="dot" aria-hidden="true"></span>
              <span>{h.name}</span>
              <span class="ct">{h.modules.length}</span>
              <svg class="chev" width="9" height="9" viewBox="0 0 10 10" aria-hidden="true">
                <path d="M3 1.5 7 5l-4 3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </summary>
            <div class="mods">
              <a class={`modlink${isHubHere && !mod ? " on" : ""}`} href={h.file}>Übersicht<span class="ct">{h.sectionCount}</span></a>
              {h.modules.map((m: any) =>
                mod && mod.id === m.id ? (
                  <div class="modnode">
                    <a class="modlink on" href={m.file}>{m.name}</a>
                    <nav class="secnav" id="secNav" aria-label="Abschnitte">
                      {navGroups(mod).map((g: any) => (
                        <>
                          {g.label && <div class="gl">{g.label}</div>}
                          {g.hashes.map((sh: string, i: number) => (
                            <a href={`#${sh}`} data-h={sh} class={!g.label && i === 0 ? "on" : undefined}>
                              {secTitle(mod, sh)}
                            </a>
                          ))}
                        </>
                      ))}
                    </nav>
                  </div>
                ) : (
                  <a class="modlink" href={m.file}>{m.name}<span class="ct">{m.sections.length || "–"}</span></a>
                )
              )}
            </div>
          </details>
        );
      })
    }
  </nav>

  <div class="rail-foot">
    {modules.length} Module · {sectionCount} Abschnitte<br />
    zuletzt {fmtDate(lastUpdated)}
  </div>
</aside>
<div class="scrim" id="scrim"></div>
