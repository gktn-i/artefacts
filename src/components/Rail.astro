---
/* ============================================================================
   Navigations-Rail — das Rückgrat der Werkbank.
   Zwei klar getrennte Zonen:
     · BIBLIOTHEK — alle Hubs; auf Index- und Hub-Seiten klappt der aktive
       Hub seine Modulliste auf. Auf Modulseiten bleibt hier alles kompakt
       eingeklappt (aufklappen geht jederzeit).
     · SCHNELLZUGRIFF — auf Seiten eines Hubs mit `tasks`: Aufgaben
       („Projekt starten", „Bauteil finden" …) mit ihren Direktlinks quer
       durch die Module. Man muss nicht wissen, in welchem Modul etwas liegt.
     · MODUL — nur auf Modulseiten: ein abgesetztes Panel mit dem aktiven
       Modul und seinen Abschnitten (samt Gruppen). Der Hash-Router der
       Modulseite bedient #secNav, das Überschriften-Subnav hängt er darunter.
   Auf Mobilgeräten wird die Rail zur Schublade (Burger in der Topbar).
   ========================================================================== */
import { hubs, modules, sectionCount, lastUpdated, fmtDate } from "../lib/registry.mjs";

interface Props {
  hub?: any;
  mod?: any;
}
const { hub, mod } = Astro.props;

const secTitle = (m: any, h: string) => m.sections.find((s: any) => s.h === h)?.t || h;
const navGroups = (m: any) =>
  m.groups
    ? m.groups.map((g: any) => ({ label: g.l, hashes: g.sections }))
    : [{ label: null, hashes: m.sections.map((s: any) => s.h) }];
---

<aside class="rail" id="rail" aria-label="Bibliothek">
  <a class="brand" href="index.html" title="Zur Übersicht">
    <span class="glyph" aria-hidden="true">A</span>
    <span class="bt"><b>Artefakte</b><i>bib.gktn.dev</i></span>
  </a>

  <button class="railsearch" type="button" data-pal>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
    </svg>
    <span class="t">Suchen …</span>
    <kbd>⌘K</kbd>
  </button>

  <nav class="tree" aria-label="Hubs und Module">
    <div class="tree-label">Bibliothek</div>
    {
      hubs.map((h: any) => {
        const isHubHere = hub && hub.id === h.id;
        return (
          <details class={`hubnode hx${isHubHere ? " here" : ""}`} open={isHubHere && !mod} style={`--hcl:${h.accent.l};--hcd:${h.accent.d}`}>
            <summary>
              <span class="dot" aria-hidden="true"></span>
              <span>{h.name}</span>
              <span class="ct">{h.modules.length}</span>
              <svg class="chev" width="9" height="9" viewBox="0 0 10 10" aria-hidden="true">
                <path d="M3 1.5 7 5l-4 3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </summary>
            <div class="mods">
              <a class={`modlink${isHubHere && !mod ? " on" : ""}`} href={h.file}>Übersicht<span class="ct">{h.sectionCount}</span></a>
              {h.modules.map((m: any) => (
                <a class={`modlink${mod && mod.id === m.id ? " on" : ""}`} href={m.file}>{m.name}<span class="ct">{m.sections.length || "–"}</span></a>
              ))}
            </div>
          </details>
        );
      })
    }

    {
      hub && hub.tasks.length > 0 && (
        <>
          <div class="tree-label ml">Schnellzugriff</div>
          <nav class="quick" aria-label={`Schnellzugriff ${hub.name}`}>
            {hub.tasks.map((t: any) => (
              <details class="qtask">
                <summary>
                  <span class="qi" aria-hidden="true">{t.icon}</span>
                  <span class="qt">{t.t}</span>
                  <svg class="chev" width="9" height="9" viewBox="0 0 10 10" aria-hidden="true">
                    <path d="M3 1.5 7 5l-4 3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </summary>
                <div class="ql">
                  {t.items.map((it: any) => (
                    <a href={it.href} title={`${it.mod.name}${it.cross ? " · " + it.mod.hub.name : ""}`}>
                      <span class="lb">{it.label}</span>
                      <span class="md">{it.cross ? `${it.mod.hub.icon} ` : ""}{it.mod.name}</span>
                    </a>
                  ))}
                  <a class="all" href={`${hub.file}#t-${t.id}`}>Alle Einstiege im Hub →</a>
                </div>
              </details>
            ))}
          </nav>
        </>
      )
    }

    {
      mod && (
        <>
          <div class="tree-label ml">Modul</div>
          <section class="railmod" aria-label={`Abschnitte von ${mod.name}`}>
            <header class="rm-head">
              <span class="rm-ic" aria-hidden="true">{mod.icon}</span>
              <div class="rm-tx">
                <a class="rm-hub" href={hub.file}>{hub.name}</a>
                <div class="rm-name">{mod.name}</div>
              </div>
            </header>
            <nav class="secnav" id="secNav" aria-label="Abschnitte">
              {navGroups(mod).map((g: any) => (
                <>
                  {g.label && <div class="gl">{g.label}</div>}
                  {g.hashes.map((sh: string, i: number) => (
                    <a href={`#${sh}`} data-h={sh} class={!g.label && i === 0 ? "on" : undefined}>
                      {secTitle(mod, sh)}
                    </a>
                  ))}
                </>
              ))}
            </nav>
          </section>
        </>
      )
    }
  </nav>

  <div class="rail-foot">
    {modules.length} Module · {sectionCount} Abschnitte<br />
    zuletzt {fmtDate(lastUpdated)}
  </div>
</aside>
<div class="scrim" id="scrim"></div>
