---
/* ============================================================================
   Kopfleiste, serverseitig gerendert — gleiche Klassen wie shell.js auf den
   Legacy-Seiten, damit public/assets/chrome.css beide Welten stylt.
   Drei Varianten: Index (nur Marke), Hub-Seite, Modul-Seite.
   ========================================================================== */
import { hubs } from "../lib/registry.mjs";

interface Props {
  hub?: any;
  mod?: any;
}
const { hub, mod } = Astro.props;
---

<div class="hbx-bar" role="navigation" aria-label="Artefakte">
  <a class="hbx-home" href="index.html" title="Zur Übersicht aller Hubs">
    <span class="m"></span><span>Artefakte</span>
  </a>

  {hub && <span class="hbx-sep">/</span>}

  {
    hub && mod && (
      <>
        <a class="hbx-crumb hub" href={hub.file} title={`${hub.name}-Hub öffnen`}>
          <span class="i">{hub.icon}</span>
          <span class="t">{hub.name}</span>
        </a>
        <span class="hbx-sep">/</span>
        <div class="hbx-pick">
          <button type="button" aria-haspopup="true" aria-expanded="false">
            <span class="i">{mod.icon}</span>
            <span class="cv">{mod.name}</span>
          </button>
          <div class="hbx-menu">
            <a href={hub.file}>
              <span class="i">{hub.icon}</span>
              <span>{hub.name}-Hub</span>
            </a>
            {hub.areas.map((ar: any) => (
              <>
                <div class="gl">{ar.name}</div>
                {ar.modules.map((m: any) => (
                  <a href={m.file} class={m.file === mod.file ? "on" : undefined}>
                    <span class="i">{m.icon}</span>
                    <span>{m.name}</span>
                    <span class="k">{m.kind}</span>
                  </a>
                ))}
              </>
            ))}
          </div>
        </div>
      </>
    )
  }

  {
    hub && !mod && (
      <div class="hbx-pick">
        <button type="button" aria-haspopup="true" aria-expanded="false">
          <span class="i">{hub.icon}</span>
          <span class="cv">{hub.name}</span>
        </button>
        <div class="hbx-menu">
          <div class="gl">Hubs</div>
          {hubs.map((h: any) => (
            <a href={h.file} class={h.file === hub.file ? "on" : undefined}>
              <span class="i">{h.icon}</span>
              <span>{h.name}</span>
              <span class="k">{h.modules.length} Module</span>
            </a>
          ))}
        </div>
      </div>
    )
  }

  <span class="hbx-spacer"></span>
  <button class="hbx-act" type="button" data-hbx-search title="Über alle Hubs, Module und Volltexte suchen">
    <span aria-hidden="true">🔍</span><span class="lbl">Suchen</span><span class="lbl-s">Suche</span>
    <span class="k">⌘K</span>
  </button>
</div>

<script>
  /* Dropdown auf/zu + Suche öffnen — Rest liefert palette.js. */
  document.querySelectorAll(".hbx-pick > button").forEach((btn) => {
    const wrap = btn.parentElement!;
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = wrap.classList.toggle("open");
      btn.setAttribute("aria-expanded", String(open));
    });
  });
  document.addEventListener("click", () => {
    document.querySelectorAll(".hbx-pick.open").forEach((w) => {
      w.classList.remove("open");
      w.querySelector("button")?.setAttribute("aria-expanded", "false");
    });
  });
  document.querySelectorAll("[data-hbx-search]").forEach((b) =>
    b.addEventListener("click", () => (window as any).HBXPAL?.open())
  );
</script>
