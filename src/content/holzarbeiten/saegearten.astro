  <rect class="box" x="390" y="66" width="200" height="8"/>
  <path class="acc" d="M604,70 H568"/><path class="accf" d="M568,70 l9,-4 v8 Z"/>
  <text class="lbl" x="490" y="102" text-anchor="middle">Blatt wird gezogen, steht unter Zug</text>
