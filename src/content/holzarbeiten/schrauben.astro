  <path class="gd" d="M158,194 L172,166"/>
  <text class="lbla" x="258" y="256" text-anchor="middle">durchgehend</text>
  <text class="lbla" x="170" y="282" text-anchor="middle">Tasche ins anstoßende Teil</text>
  <text class="lbl" x="170" y="302" text-anchor="middle">Gewinde greift quer zur Faser — hält</text>
