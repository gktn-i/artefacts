  <text class="lbl" x="620" y="218" text-anchor="end">Sichtseite</text>
  <text class="lbla" x="466" y="256" text-anchor="middle">Fasern laufen parallel zur Schraube</text>
  <text class="lbla" x="490" y="282" text-anchor="middle">Tasche ins durchgehende Teil</text>
