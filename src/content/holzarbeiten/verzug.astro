<tr><td><b>Raute</b></td><td><span class="b ok">nachhobeln</span></td><td><span class="b bad">nein</span></td><td><span class="b bad">nein</span></td><td><span class="b bad">nein</span></td><td><span class="b bad">nein</span></td></tr>
