<h2>Welche Methode für welchen Verzug</h2>
<div class="tbl-wrap"><table style="min-width:820px">
<thead><tr><th>Verzug</th><th>Abrichten</th><th>Wasser, Gewicht</th><th>Auftrennen</th><th>Kürzen</th><th>Konstruktiv</th></tr></thead>
<tbody>
<tr><td><b>Schüsseln</b></td><td><span class="b ok">ja</span> bei Reserve</td><td><span class="b ok">ja</span> vorher</td><td><span class="b ok">ja</span> ab 5 mm</td><td><span class="b bad">bringt nichts</span></td><td><span class="b ok">Gratleiste</span></td></tr>
<tr><td><b>Bogen</b></td><td><span class="b mid">viel Verlust</span></td><td><span class="b mid">teilweise</span></td><td><span class="b bad">bleibt</span></td><td><span class="b ok">ja</span></td><td><span class="b mid">Rahmen hält</span></td></tr>
<tr><td><b>Säbel</b></td><td><span class="b bad">falsche Richtung</span></td><td><span class="b bad">nein</span></td><td><span class="b mid">schmale Leisten</span></td><td><span class="b ok">Kante absägen</span></td><td><span class="b bad">nein</span></td></tr>
