  <text class="lbl" x="160" y="160" text-anchor="middle">Messerwelle unten</text>
  <text class="lbla" x="160" y="186" text-anchor="middle">Unterseite wird plan</text>
  <text class="lbl" x="160" y="206" text-anchor="middle">Bezug: der Tisch</text>
