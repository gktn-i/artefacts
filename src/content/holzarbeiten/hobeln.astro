<thead><tr><th>Regel</th><th>Abrichte</th><th>Dickenhobel</th></tr></thead>
<tbody>
<tr><td><b>Abtrag pro Durchgang</b></td><td>1 bis 2 mm</td><td>0,5 bis 1,5 mm, Hartholz weniger</td></tr>
<tr><td><b>Mindestlänge Werkstück</b></td><td>30 cm, Hände nie über der Welle</td><td>Länger als der Abstand der Walzen, meist 25 cm</td></tr>
<tr><td><b>Hilfsmittel</b></td><td>Schiebeholz, Schutzhaube bis ans Werkstück</td><td>Auslauftisch stützen, Zulage bei dünnem Holz</td></tr>
<tr><td><b>Verwundenes Brett</b></td><td>Hohle Seite nach unten, nicht kippeln</td><td>Erst abrichten, sonst kopiert er die Krümmung</td></tr>
