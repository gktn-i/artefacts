<svg class="dg l" viewBox="0 0 660 265" role="img" aria-label="Querschnitt eines Stammes mit Mark, Kernholz, Splintholz, Kambium und Rinde">
  <circle class="box" cx="150" cy="120" r="100" />
  <circle class="accs" cx="150" cy="120" r="62" />
  <g class="wt" fill="none"><circle cx="150" cy="120" r="20"/><circle cx="150" cy="120" r="34"/><circle cx="150" cy="120" r="48"/><circle cx="150" cy="120" r="78"/><circle cx="150" cy="120" r="90"/></g>
  <circle class="f" cx="150" cy="120" r="4" />
  <path class="gd" d="M154,116 L282,48" /><text class="lbla" x="290" y="52" text-anchor="start">Mark</text>
  <path class="gd" d="M194,76 L282,84" /><text class="lbla" x="290" y="88" text-anchor="start">Kernholz · dauerhaft</text>
  <path class="gd" d="M219,80 L282,120" /><text class="lbla" x="290" y="124" text-anchor="start">Splintholz · nicht dauerhaft</text>
  <path class="gd" d="M238,150 L282,152" /><text class="lbla" x="290" y="156" text-anchor="start">Kambium · Wachstumsschicht</text>
