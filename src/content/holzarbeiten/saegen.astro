  <text class="lblb" x="165" y="260" text-anchor="middle">schöne Seite nach unten</text>
  <text class="lbl" x="165" y="282" text-anchor="middle">Blatt sitzt über dem Brett</text>
  <!-- Tischkreissäge: Blatt von unten, Zahn fährt nach unten -->
