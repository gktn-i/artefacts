  <th data-s="num">Tempo</th>
  <th>Nimm es für</th>
</tr></thead>
<tbody>
<tr>
  <td><b>Glatter Nagel</b></td>
  <td class="pc lo txt"><span class="dots" aria-hidden="true"><i class="on"></i><i></i><i></i><i></i><i></i></span><span class="sr">1 von 5</span></td>
  <td class="pc hi txt"><span class="dots" aria-hidden="true"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i></i></span><span class="sr">4 von 5</span></td>
