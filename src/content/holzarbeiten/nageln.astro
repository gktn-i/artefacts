<div class="tbl-wrap"><table style="min-width:820px">
<thead><tr><th data-s="txt">Typ</th><th data-s="num">Rückenbreite</th><th data-s="num">Drahtstärke</th><th data-s="num">Längen</th><th>Wofür</th></tr></thead>
<tbody>
<tr><td><b>Typ 53</b> (Feindraht)</td><td>11,3 mm</td><td>0,74 mm</td><td>4 bis 14 mm</td>
  <td class="txt">Polsterstoff, dünne Rückwände, Dekor, Kabelschellen</td></tr>
<tr><td><b>Typ 140</b> (Flachdraht)</td><td>10,6 mm</td><td>1,25 mm</td><td>6 bis 14 mm</td>
