  <td><b>Schraube</b></td>
  <td class="pc hi txt"><span class="dots" aria-hidden="true"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i></span><span class="sr">5 von 5</span></td>
