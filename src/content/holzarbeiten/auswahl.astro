<tr><td><b>MDF 19 mm</b></td><td>20 bis 30 €</td><td class="txt">Baumarkt, Holzhandel</td></tr>
<tr><td><b>OSB/3 18 mm</b></td><td>15 bis 25 €</td><td class="txt">Baumarkt, ganze Platten</td></tr>
