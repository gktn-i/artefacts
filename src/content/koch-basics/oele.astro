        <div class="spec-row"><div class="sr-label bad">Contra</div><div class="sr-val">Verbrennt früh, nicht für hohe Hitze</div></div>
        <div class="spec-row"><div class="sr-label good">Gut für</div><div class="sr-val">Sanftes Braten, Saucen, Finishen, Arrosieren</div></div>
        <div class="spec-row"><div class="sr-label bad">Nicht für</div><div class="sr-val">Scharf Anbraten allein, Frittieren</div></div>
      </div>
    </div>
  </div>
</div>

<div class="card spec-card">
  <div class="sc-grid">
    <div class="sc-main">
