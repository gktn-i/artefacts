      <div class="kb-row"><div class="kb-bar" style="--l:63.6%;--w:18.2%"><span>Sautieren <em>180–220</em></span></div></div>
      <div class="kb-row"><div class="kb-bar lft" style="--l:72.7%;--w:22.7%"><span>Scharf anbraten <em>200–250</em></span></div></div>
