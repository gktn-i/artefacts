<tbody>
<tr><td><b>POM</b> (Delrin)</td><td><span class="b ok">gut</span></td><td><span class="b ok">gut</span></td><td><span class="b mid">bedingt</span></td><td>Robust gegen Öle; empfindlich gegen starke Säuren</td></tr>
<tr><td><b>PA</b> (Nylon)</td><td><span class="b ok">gut</span></td><td><span class="b ok">gut</span></td><td><span class="b ok">gut</span></td><td>Nimmt eher Wasser auf als Öl</td></tr>
<tr><td><b>PE, PP</b></td><td><span class="b ok">gut</span></td><td><span class="b ok">gut</span></td><td><span class="b ok">gut</span></td><td>Sehr beständig, dafür schlecht klebbar</td></tr>
