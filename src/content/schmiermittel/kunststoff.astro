<h2>Elastomere und Dichtungen</h2>
<div class="tbl-wrap"><table style="min-width:960px">
<thead><tr><th data-s="text">Werkstoff</th><th>Mineralöl</th><th>Silikonöl, -fett</th><th>Bremsflüssigkeit (Glykol)</th><th>Wasser, Dampf</th><th data-s="num">Temperatur</th></tr></thead>
<tbody>
<tr><td><b>NBR</b> (Nitril)</td><td><span class="b ok">gut</span></td><td><span class="b ok">gut</span></td><td><span class="b bad">schlecht</span></td><td><span class="b mid">bedingt</span></td><td>-30 … +100 °C</td></tr>
<tr><td><b>FKM</b> (Viton)</td><td><span class="b ok">gut</span></td><td><span class="b ok">gut</span></td><td><span class="b bad">schlecht</span></td><td><span class="b mid">bedingt</span></td><td>-20 … +200 °C</td></tr>
<tr><td><b>EPDM</b></td><td><span class="b bad">schlecht</span></td><td><span class="b ok">gut</span></td><td><span class="b ok">gut</span></td><td><span class="b ok">gut</span></td><td>-45 … +150 °C</td></tr>
