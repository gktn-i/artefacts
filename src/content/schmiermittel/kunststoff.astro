<tr><td><b>ABS, ASA</b></td><td><span class="b mid">bedingt</span></td><td><span class="b ok">gut</span></td><td><span class="b bad">schlecht</span></td><td>Aceton und Ketone lösen ABS regelrecht auf</td></tr>
