  <path class="accf" d="M124,52 l-8,-4 v8 z M248,52 l-8,-4 v8 z M388,52 l-8,-4 v8 z M528,52 l-8,-4 v8 z" />
  <!-- PID-Zweige -->
  <path class="acc" d="M589,74 V104 H90 V132" />
  <path class="accf" d="M90,132 l-4,-8 h8 z" />
