  <text class="lblb" x="308" y="49" text-anchor="middle">RPM-Filter</text>
  <text class="lbl" x="308" y="64" text-anchor="middle">Kerben je Motor</text>
  <rect class="accs" x="392" y="30" width="112" height="44" rx="6" />
  <text class="lblb" x="448" y="49" text-anchor="middle">Dyn. Kerbfilter</text>
  <text class="lbl" x="448" y="64" text-anchor="middle">sucht Restspitzen</text>
  <rect class="box" x="532" y="30" width="114" height="44" rx="6" />
  <text class="lblb" x="589" y="49" text-anchor="middle">sauberes Signal</text>
