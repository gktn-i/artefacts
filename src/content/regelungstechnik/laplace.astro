  <path class="f" d="M56,156 l8,8 M64,156 l-8,8" style="stroke:var(--text);stroke-width:2" />
  <text class="lbl" x="60" y="70" text-anchor="middle">Polpaar</text>
  <text class="lbl" x="60" y="182" text-anchor="middle">→ Schwingung</text>
  <circle class="w" cx="150" cy="120" r="6" style="fill:none" />
  <text class="lbl" x="150" y="146" text-anchor="middle">Nullstelle</text>
