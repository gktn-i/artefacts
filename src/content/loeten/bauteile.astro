<tr><td><b>2512</b></td><td>6332</td><td>6,3 × 3,2 mm</td><td>sehr gut, typisch für Shunts und Leistungswiderstände (1 W)</td></tr>
<tr><td><b>1210</b></td><td>3225</td><td>3,2 × 2,5 mm</td><td>sehr gut, große MLCC und Polyfuses</td></tr>
<tr><td><b>1206</b></td><td>3216</td><td>3,2 × 1,6 mm</td><td>sehr gut, guter Einstieg</td></tr>
<tr><td><b>0805</b></td><td>2012</td><td>2,0 × 1,25 mm</td><td>einsteigerfreundlich</td></tr>
<tr><td><b>0603</b></td><td>1608</td><td>1,6 × 0,8 mm</td><td>mit etwas Übung gut</td></tr>
<tr><td><b>0402</b></td><td>1005</td><td>1,0 × 0,5 mm</td><td>fummelig, Pinzette und Lupe oder Mikroskop nötig</td></tr>
