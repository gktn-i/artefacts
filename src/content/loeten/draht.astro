<tr><td><b>0,40 mm</b></td><td>26</td><td>0,13 Ω/m</td><td>~2,2 A</td><td>Alles ab etwa 1 A — darunter wird es warm</td></tr>
<tr><td><b>0,51 mm</b></td><td>24</td><td>0,084 Ω/m</td><td>~3,5 A</td><td>Leistungsbrücken, Motor- und Ladeleitungen</td></tr>
