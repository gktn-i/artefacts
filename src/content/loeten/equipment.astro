<div class="tbl-wrap"><table style="min-width:560px">
<thead><tr><th>Code</th><th>Form</th><th>Am besten für</th></tr></thead>
<tbody>
<tr><td><b>B / BL</b></td><td>konisch / Bleistift</td><td>Kabel, THT, allround-fein — wenig Kontaktfläche</td></tr>
<tr><td><b>BC / C</b></td><td>abgeschrägte Fläche (Hufeisen)</td><td>Der Alltags-Favorit: THT, SMD-Chips, Drag — hält einen Lottropfen</td></tr>
<tr><td><b>D</b></td><td>Meißel / Schraubendreher</td><td>Stiftleisten, flache Kante, Masseflächen</td></tr>
