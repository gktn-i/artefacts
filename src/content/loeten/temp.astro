  <line class="dash" x1="45" y1="104" x2="545" y2="104"/><text class="lbl" x="8" y="108">150</text>
  <line class="melt" x1="45" y1="53" x2="545" y2="53"/><text class="lbl" x="8" y="57">217</text>
  <text class="lbl" x="52" y="47" fill="#e24b4a">Schmelzpunkt SAC305 (217 °C)</text>
  <text class="lbl" x="8" y="35">245</text>
  <line class="dash" x1="200" y1="15" x2="200" y2="220"/>
  <line class="dash" x1="330" y1="15" x2="330" y2="220"/>
  <line class="dash" x1="440" y1="15" x2="440" y2="220"/>
  <path class="curve" d="M45,201 L200,104 L330,85 C352,79 368,31 388,31 C406,31 420,70 440,88 L545,196"/>
