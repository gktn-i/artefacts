<tbody>
<tr><td><b>Kochmesser / Gyuto</b></td><td>20–24 cm</td><td>80 % aller Schnitte: Zwiebeln, Kräuter, Fleisch, Wiegen und Hacken</td><td>Kochmesser mit Kropf, 55–58 HRC, 15–18° je Seite</td><td>Gyuto ohne Kropf, 60–64 HRC, 10–15°, dünner</td><td>1.</td></tr>
<tr><td><b>Petty / Officemesser</b></td><td>9–15 cm</td><td>Obst, Schalotten, Knoblauch, alles in der Hand</td><td>Officemesser 8–10 cm</td><td>Petty 12–15 cm</td><td>2.</td></tr>
<tr><td><b>Brotmesser</b></td><td>20–26 cm</td><td>Kruste, Braten mit Kruste, Kürbis</td><td>Wellenschliff, gerade oder leicht gebogen</td><td>Pankiri, selten</td><td>3.</td></tr>
<tr><td><b>Santoku oder Nakiri</b></td><td>16–18 cm</td><td>Gemüse im Hackschnitt; Santoku als kleines Allroundmesser</td><td>Santoku „europäisiert“ mit Kropf</td><td>Nakiri rechteckig, Santoku mit Sheepsfoot-Spitze</td><td>4. (statt oder neben dem Kochmesser)</td></tr>
