---
import "./_style.css";
---
<div class="kurz"><b>Begriffe nach Bereich, mit englischer Entsprechung.</b> Klinge, Griff, Mechanik, Schliff, Stahl, Schärfen, Recht und die japanische Küche — jeweils die Wörter, die in Datenblättern, Shops und Foren tatsächlich fallen. Alphabetisch und durchsuchbar: <a href="#glossar">Glossar A–Z</a>.</div>

<h2>Klinge</h2>
<div class="flist">
  <div class="frow hd"><span>Deutsch</span><span>Englisch</span><span>Bedeutung</span></div>
  <div class="frow"><span class="fn">Spitze</span><span class="fe">point</span><span class="fx">Vorderes Ende; Lage (auf, über, unter der Mittellinie) definiert die Klingenform</span></div>
  <div class="frow"><span class="fn">Rücken</span><span class="fe">spine</span><span class="fx">Ungeschärfte Oberkante; seine Dicke (1,5–6 mm) bestimmt Steifigkeit und Gewicht</span></div>
  <div class="frow"><span class="fn">Schneide</span><span class="fe">edge</span><span class="fx">Die geschärfte Kante — genauer der Apex, wo beide Fasen sich treffen</span></div>
  <div class="frow"><span class="fn">Bauch</span><span class="fe">belly</span><span class="fx">Der gebogene Teil der Schneide vor der Spitze; ziehende Schnitte</span></div>
  <div class="frow"><span class="fn">Flanke / Primärfase</span><span class="fe">primary bevel, grind</span><span class="fx">Die große Schliffläche vom Rücken oder aus Klingenmitte zur Schneide</span></div>
  <div class="frow"><span class="fn">Sekundärfase / Schneidfase</span><span class="fe">secondary bevel, edge bevel</span><span class="fx">Die kleine Fläche direkt an der Schneide, die beim Nachschärfen bearbeitet wird</span></div>
  <div class="frow"><span class="fn">Mikrofase</span><span class="fe">microbevel</span><span class="fx">Winzige dritte Fase mit größerem Winkel zur Stabilisierung</span></div>
  <div class="frow"><span class="fn">Ricasso</span><span class="fe">ricasso</span><span class="fx">Ungeschliffener Klingenabschnitt vor dem Griff; zählt zur Klingenlänge</span></div>
  <div class="frow"><span class="fn">Choil</span><span class="fe">choil</span><span class="fx">Aussparung am Klingenfuß: Fingerchoil (zum Greifen) oder Sharpening Choil (Schärfen bis zum Ende)</span></div>
  <div class="frow"><span class="fn">Kropf</span><span class="fe">bolster (kitchen)</span><span class="fx">Verdickung zwischen Klinge und Griff bei europäischen Küchenmessern; Fingerschutz und Balance</span></div>
  <div class="frow"><span class="fn">Schulter</span><span class="fe">shoulder</span><span class="fx">Übergang von Flanke zu Sekundärfase</span></div>
  <div class="frow"><span class="fn">Plunge Line</span><span class="fe">plunge line</span><span class="fx">Der Übergang, an dem die Primärfase am Klingenfuß beginnt</span></div>
  <div class="frow"><span class="fn">Falschschneide / Swedge</span><span class="fe">swedge, false edge</span><span class="fx">Geschliffener, aber ungeschärfter Bereich am Rücken nahe der Spitze (Bowie, Clip Point)</span></div>
  <div class="frow"><span class="fn">Hohlkehle</span><span class="fe">fuller</span><span class="fx">Längsrille in der Flanke — spart Gewicht, keine „Blutrinne“</span></div>
  <div class="frow"><span class="fn">Distal Taper</span><span class="fe">distal taper</span><span class="fx">Verjüngung der Rückenstärke zur Spitze</span></div>
  <div class="frow"><span class="fn">Jimping</span><span class="fe">jimping</span><span class="fx">Daumenriffelung auf Rücken oder Griff</span></div>
  <div class="frow"><span class="fn">Dicke hinter der Schneide</span><span class="fe">behind-the-edge thickness (BTE)</span><span class="fx">Klingendicke direkt oberhalb der Sekundärfase; die wichtigste Zahl für die Schneidleistung</span></div>
</div>

<h2>Griff und Aufbau</h2>
<div class="flist">
  <div class="frow hd"><span>Deutsch</span><span>Englisch</span><span>Bedeutung</span></div>
  <div class="frow"><span class="fn">Erl</span><span class="fe">tang</span><span class="fx">Der Teil der Klinge im Griff: Full Tang, Hidden/Stick Tang, Rat Tail, Skeletonized</span></div>
  <div class="frow"><span class="fn">Griffschalen</span><span class="fe">scales, handle slabs</span><span class="fx">Beidseitig auf den Erl oder die Liner gesetzte Platten</span></div>
  <div class="frow"><span class="fn">Liner</span><span class="fe">liner</span><span class="fx">Metallplatten (Stahl, Titan) unter den Schalen eines Folders</span></div>
  <div class="frow"><span class="fn">Bolster / Backen</span><span class="fe">bolster</span><span class="fx">Metallteile an Griffenden; vorn als Parierelement, hinten als Abschluss</span></div>
  <div class="frow"><span class="fn">Parierelement</span><span class="fe">guard</span><span class="fx">Quer stehender Fingerschutz zwischen Griff und Klinge</span></div>
  <div class="frow"><span class="fn">Knauf</span><span class="fe">pommel</span><span class="fx">Griffende, oft mit Fangriemenloch oder Glasbrecher</span></div>
  <div class="frow"><span class="fn">Fangriemenloch</span><span class="fe">lanyard hole</span><span class="fx">Bohrung für Schlaufe oder Paracord</span></div>
  <div class="frow"><span class="fn">Backspacer</span><span class="fe">backspacer</span><span class="fx">Durchgehendes Rückenteil zwischen den Griffhälften eines Folders</span></div>
  <div class="frow"><span class="fn">Standoffs</span><span class="fe">standoffs</span><span class="fx">Distanzhülsen statt Backspacer — offener Griffaufbau</span></div>
  <div class="frow"><span class="fn">Clip</span><span class="fe">pocket clip</span><span class="fx">Taschenclip; tip-up/tip-down, deep carry, umsetzbar</span></div>
  <div class="frow"><span class="fn">Wa-Griff / Yo-Griff</span><span class="fe">wa handle / yo handle</span><span class="fx">Japanischer Holzgriff (rund, oval, achteckig, aufgesteckt) gegen westlichen Griff mit Nieten und Kropf</span></div>
  <div class="frow"><span class="fn">Zwinge</span><span class="fe">ferrule</span><span class="fx">Ring am Griffanfang, bei Wa-Griffen aus Büffelhorn</span></div>
  <div class="frow"><span class="fn">Kydex / Scheide</span><span class="fe">sheath</span><span class="fx">Trageschutz für feststehende Messer: Kydex (Thermoplast), Leder, Nylon, Holz</span></div>
</div>

<h2>Mechanik (Klappmesser)</h2>
<div class="flist">
  <div class="frow hd"><span>Deutsch</span><span>Englisch</span><span>Bedeutung</span></div>
  <div class="frow"><span class="fn">Pivot</span><span class="fe">pivot</span><span class="fx">Drehachse; Schraube mit Bronze-Scheiben oder Kugellagern</span></div>
  <div class="frow"><span class="fn">Detent</span><span class="fe">detent</span><span class="fx">Kugel im Liner, die die Klinge geschlossen hält; die nötige Öffnungskraft</span></div>
  <div class="frow"><span class="fn">Verriegelung / Lock</span><span class="fe">lock</span><span class="fx">Slipjoint (keine), Back, Liner, Frame, Axis/Crossbar, Compression, Button, Ball Bearing, Ring</span></div>
  <div class="frow"><span class="fn">Lockbar</span><span class="fe">lock bar</span><span class="fx">Die federnde Sperre bei Liner- und Frame-Lock</span></div>
  <div class="frow"><span class="fn">Lock-Einsatz</span><span class="fe">lockbar insert</span><span class="fx">Stahlplättchen am Titan-Lockbar gegen Verschleiß und Kleben</span></div>
  <div class="frow"><span class="fn">Stoppstift</span><span class="fe">stop pin</span><span class="fx">Stift, an dem die Klinge offen (und oft geschlossen) anschlägt</span></div>
  <div class="frow"><span class="fn">Lockup</span><span class="fe">lockup</span><span class="fx">Wie weit der Lock den Klingenfuß überdeckt (früh/spät)</span></div>
  <div class="frow"><span class="fn">Blade Play</span><span class="fe">blade play</span><span class="fx">Spiel der offenen Klinge, seitlich oder vertikal</span></div>
  <div class="frow"><span class="fn">Daumenpin / Daumenloch / Flipper / Wave</span><span class="fe">thumb stud / hole / flipper / Wave</span><span class="fx">Einhand-Öffnungshilfen; in Deutschland mit Verriegelung → Einhandmesser</span></div>
  <div class="frow"><span class="fn">Federunterstützt</span><span class="fe">assisted opening</span><span class="fx">Torsionsfeder vollendet die Öffnung; kein Springmesser nach BKA 2004, aber Grauzone</span></div>
  <div class="frow"><span class="fn">Halbstopp</span><span class="fe">half stop</span><span class="fx">Slipjoint-Raste in 90°-Stellung als Sicherheit beim Schließen</span></div>
  <div class="frow"><span class="fn">Walk and Talk</span><span class="fe">walk and talk</span><span class="fx">Slipjoint-Jargon: Federspannung (walk) und Einrastgeräusch (talk)</span></div>
</div>

<h2>Schliff und Geometrie</h2>
<div class="flist">
  <div class="frow hd"><span>Deutsch</span><span>Englisch</span><span>Bedeutung</span></div>
  <div class="frow"><span class="fn">Flachschliff</span><span class="fe">flat grind (FFG = full flat grind)</span><span class="fx">Gerade Flanken vom Rücken (voll) oder aus der Mitte (Sabre)</span></div>
  <div class="frow"><span class="fn">Hohlschliff</span><span class="fe">hollow grind</span><span class="fx">Konkave Flanken</span></div>
  <div class="frow"><span class="fn">Balliger Schliff</span><span class="fe">convex grind</span><span class="fx">Konvexe Flanken, oft ohne Sekundärfase</span></div>
  <div class="frow"><span class="fn">Scandi</span><span class="fe">Scandinavian grind</span><span class="fx">Eine breite Fase ohne Sekundärfase</span></div>
  <div class="frow"><span class="fn">Meißelschliff</span><span class="fe">chisel grind</span><span class="fx">Nur eine Seite geschliffen</span></div>
  <div class="frow"><span class="fn">Zero Grind</span><span class="fe">zero grind</span><span class="fx">Flanke läuft ohne Sekundärfase bis zum Apex</span></div>
  <div class="frow"><span class="fn">Kasumi</span><span class="fe">kasumi</span><span class="fx">Nebelartiges Finish auf japanischen Laminatklingen (weicher Mantel matt, harter Kern glänzend)</span></div>
  <div class="frow"><span class="fn">Shinogi</span><span class="fe">shinogi</span><span class="fx">Grat zwischen Flanke und Fase bei japanischen Einseitschliffen</span></div>
  <div class="frow"><span class="fn">Ura / Urasuki</span><span class="fe">ura</span><span class="fx">Hohl ausgeschliffene Rückseite eines einseitig geschliffenen japanischen Messers</span></div>
  <div class="frow"><span class="fn">Inklusiver Winkel</span><span class="fe">inclusive angle</span><span class="fx">Summe beider Seitenwinkel; „20°“ kann je Seite oder inklusiv heißen</span></div>
  <div class="frow"><span class="fn">Ausdünnen</span><span class="fe">thinning</span><span class="fx">Flanken abtragen, um die Dicke hinter der Schneide zu senken</span></div>
</div>

<h2>Stahl</h2>
<div class="flist">
  <div class="frow hd"><span>Deutsch</span><span>Englisch</span><span>Bedeutung</span></div>
  <div class="frow"><span class="fn">HRC</span><span class="fe">Rockwell C</span><span class="fx">Härteskala; Messer 55–67</span></div>
  <div class="frow"><span class="fn">Karbid</span><span class="fe">carbide</span><span class="fx">Harte Partikel (Cr, V, Nb, Mo, W) in der Stahlmatrix — Schnitthaltigkeit, Schärfbarkeit</span></div>
  <div class="frow"><span class="fn">Martensit</span><span class="fe">martensite</span><span class="fx">Die harte Phase nach dem Abschrecken</span></div>
  <div class="frow"><span class="fn">Restaustenit</span><span class="fe">retained austenite</span><span class="fx">Weiche, nicht umgewandelte Phase; Kryo verringert sie</span></div>
  <div class="frow"><span class="fn">Anlassen</span><span class="fe">tempering</span><span class="fx">Erwärmen nach dem Härten für Zähigkeit</span></div>
  <div class="frow"><span class="fn">Kryo / Tiefkühlen</span><span class="fe">cryo treatment</span><span class="fx">−70 bis −196 °C nach dem Abschrecken</span></div>
  <div class="frow"><span class="fn">Pulvermetallurgie (PM, CPM)</span><span class="fe">powder metallurgy</span><span class="fx">Verdüsen der Schmelze zu Pulver — feine Karbide</span></div>
  <div class="frow"><span class="fn">Rostfrei</span><span class="fe">stainless</span><span class="fx">≥ ca. 12 % Chrom in Lösung</span></div>
  <div class="frow"><span class="fn">Kohlenstoffstahl</span><span class="fe">carbon steel</span><span class="fx">Unlegiert oder niedriglegiert, rostet, feine Schärfe</span></div>
  <div class="frow"><span class="fn">San Mai / Laminat</span><span class="fe">san mai</span><span class="fx">Harter Kern zwischen weichen oder rostfreien Lagen</span></div>
  <div class="frow"><span class="fn">Damast</span><span class="fe">damascus (pattern-welded)</span><span class="fx">Schweißverbund aus zwei Stählen mit Muster</span></div>
  <div class="frow"><span class="fn">Hagane / Jigane</span><span class="fe">hagane / jigane</span><span class="fx">Japanisch: harter Schneidenstahl / weiches Mantel- oder Trägereisen</span></div>
  <div class="frow"><span class="fn">Patina</span><span class="fe">patina</span><span class="fx">Kontrollierte Oxidschicht (Magnetit) auf Kohlenstoffstahl</span></div>
  <div class="frow"><span class="fn">Schnitthaltigkeit</span><span class="fe">edge retention</span><span class="fx">Wie lange die Schärfe hält (CATRA-Test)</span></div>
  <div class="frow"><span class="fn">Zähigkeit</span><span class="fe">toughness</span><span class="fx">Widerstand gegen Bruch und Ausbruch (Charpy)</span></div>
</div>

<h2>Schärfen</h2>
<div class="flist">
  <div class="frow hd"><span>Deutsch</span><span>Englisch</span><span>Bedeutung</span></div>
  <div class="frow"><span class="fn">Apex</span><span class="fe">apex</span><span class="fx">Die eigentliche Schneidkante, Radius 0,1–20 µm</span></div>
  <div class="frow"><span class="fn">Grat</span><span class="fe">burr, wire edge</span><span class="fx">Umgebogener Metallsaum beim Schärfen; muss entfernt werden</span></div>
  <div class="frow"><span class="fn">Körnung</span><span class="fe">grit</span><span class="fx">Feinheit des Schleifmittels; JIS, FEPA, ANSI nicht vergleichbar — µm zählen</span></div>
  <div class="frow"><span class="fn">Wasserstein / Ölstein</span><span class="fe">water stone / oil stone</span><span class="fx">Steine mit Wasser bzw. Öl als Schmiermittel</span></div>
  <div class="frow"><span class="fn">Slurry / Schlamm</span><span class="fe">slurry</span><span class="fx">Schleifbrei aus gelösten Körnern auf Wassersteinen</span></div>
  <div class="frow"><span class="fn">Abrichten</span><span class="fe">flattening, lapping</span><span class="fx">Stein plan schleifen</span></div>
  <div class="frow"><span class="fn">Schneide voran / nachlaufend</span><span class="fe">edge-leading / edge-trailing</span><span class="fx">Zugrichtung auf Stein oder Riemen</span></div>
  <div class="frow"><span class="fn">Abziehen / Strop</span><span class="fe">stropping</span><span class="fx">Grat entfernen und polieren auf Leder oder Balsa</span></div>
  <div class="frow"><span class="fn">Wetzen</span><span class="fe">honing</span><span class="fx">Aufrichten der Schneide mit Wetzstahl oder Keramikstab ohne Schärfen</span></div>
  <div class="frow"><span class="fn">Toothy / poliert</span><span class="fe">toothy / polished edge</span><span class="fx">Grobe (Ziehschnitt) oder feine (Drückschnitt) Abschlussschärfe</span></div>
  <div class="frow"><span class="fn">BESS</span><span class="fe">Brubacher Edge Sharpness Scale</span><span class="fx">Schärfemessung in Gramm Schneidkraft</span></div>
  <div class="frow"><span class="fn">Geführtes System</span><span class="fe">guided sharpener</span><span class="fx">Winkelhaltende Vorrichtung (Sharpmaker, KME, Wicked Edge)</span></div>
</div>

<h2>Recht (Deutschland)</h2>
<div class="flist">
  <div class="frow hd"><span>Deutsch</span><span>Englisch</span><span>Bedeutung</span></div>
  <div class="frow"><span class="fn">Führen</span><span class="fe">carrying</span><span class="fx">Tatsächliche Gewalt außerhalb von Wohnung, Geschäftsräumen, befriedetem Besitztum</span></div>
  <div class="frow"><span class="fn">Besitz</span><span class="fe">possession</span><span class="fx">Tatsächliche Gewalt; bei nicht verbotenen Messern frei</span></div>
  <div class="frow"><span class="fn">Einhandmesser</span><span class="fe">one-hand opening locking knife</span><span class="fx">Einhändig zu öffnen und feststellbar (§ 42a)</span></div>
  <div class="frow"><span class="fn">Feststehendes Messer über 12 cm</span><span class="fe">fixed blade over 12 cm</span><span class="fx">Führungsverbot nach § 42a Abs. 1 Nr. 3</span></div>
  <div class="frow"><span class="fn">Berechtigtes Interesse</span><span class="fe">legitimate interest</span><span class="fx">Beruf, Brauchtum, Sport, anerkannter Zweck — nicht Selbstverteidigung</span></div>
  <div class="frow"><span class="fn">Verschlossenes Behältnis</span><span class="fe">locked container</span><span class="fx">Ausnahme vom Führungsverbot; nicht mit wenigen Handgriffen erreichbar</span></div>
  <div class="frow"><span class="fn">Nicht zugriffsbereit</span><span class="fe">not readily accessible</span><span class="fx">Ausnahme bei Veranstaltungen, Fernverkehr, Zonen</span></div>
  <div class="frow"><span class="fn">Verbotener Gegenstand</span><span class="fe">prohibited item</span><span class="fx">Springmesser, Fallmesser, Faustmesser, Butterflymesser (Anlage 2)</span></div>
  <div class="frow"><span class="fn">Hieb- und Stoßwaffe</span><span class="fe">edged weapon</span><span class="fx">Dolche, Schwerter, Kampfmesser — Waffen im Sinne des WaffG</span></div>
  <div class="frow"><span class="fn">Waffen- und Messerverbotszone</span><span class="fe">weapons exclusion zone</span><span class="fx">Landesverordnung nach § 42 Abs. 5; alle Messer</span></div>
  <div class="frow"><span class="fn">Feststellungsbescheid</span><span class="fe">BKA classification ruling</span><span class="fx">Verbindliche Einordnung eines Gegenstands durch das BKA (§ 2 Abs. 5)</span></div>
</div>

<h2>Japanische Küchenmesser</h2>
<div class="flist">
  <div class="frow hd"><span>Deutsch</span><span>Englisch</span><span>Bedeutung</span></div>
  <div class="frow"><span class="fn">Gyuto</span><span class="fe">gyuto</span><span class="fx">Kochmesser 21–27 cm</span></div>
  <div class="frow"><span class="fn">Santoku</span><span class="fe">santoku</span><span class="fx">Allzweckmesser 16–18 cm, „drei Tugenden“</span></div>
  <div class="frow"><span class="fn">Nakiri</span><span class="fe">nakiri</span><span class="fx">Gemüsemesser, rechteckig</span></div>
  <div class="frow"><span class="fn">Usuba</span><span class="fe">usuba</span><span class="fx">Einseitig geschliffenes Gemüsemesser der Profis</span></div>
  <div class="frow"><span class="fn">Petty</span><span class="fe">petty</span><span class="fx">Kleines Allzweckmesser 12–15 cm</span></div>
  <div class="frow"><span class="fn">Sujihiki</span><span class="fe">sujihiki</span><span class="fx">Langes Tranchiermesser 24–30 cm</span></div>
  <div class="frow"><span class="fn">Deba</span><span class="fe">deba</span><span class="fx">Dickes Fischmesser, einseitig</span></div>
  <div class="frow"><span class="fn">Yanagiba</span><span class="fe">yanagiba</span><span class="fx">Sashimi-Messer, lang, einseitig</span></div>
  <div class="frow"><span class="fn">Honesuki</span><span class="fe">honesuki</span><span class="fx">Geflügel-Ausbeinmesser, dreieckig</span></div>
  <div class="frow"><span class="fn">Bunka / Kiritsuke</span><span class="fe">bunka / kiritsuke</span><span class="fx">Santoku bzw. Gyuto mit abgeschrägter „K-Tip“-Spitze</span></div>
  <div class="frow"><span class="fn">Kurouchi</span><span class="fe">kurouchi</span><span class="fx">Schwarze Schmiedehaut als Finish</span></div>
  <div class="frow"><span class="fn">Tsuchime</span><span class="fe">tsuchime</span><span class="fx">Gehämmerte Oberfläche</span></div>
  <div class="frow"><span class="fn">Hamon</span><span class="fe">hamon</span><span class="fx">Sichtbare Härtelinie bei differenziell gehärteten Klingen</span></div>
  <div class="frow"><span class="fn">Kataba / Ryoba</span><span class="fe">kataba / ryoba</span><span class="fx">Einseitiger / beidseitiger Schliff</span></div>
</div>

