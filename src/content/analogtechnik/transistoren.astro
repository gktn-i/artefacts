  <circle class="accs" cx="190" cy="95" r="30" />
  <text class="lbla" x="190" y="100" text-anchor="middle" style="font-size:12px">M</text>
  <text class="lbl" x="46" y="24">+U</text>
  <text class="lbl" x="46" y="186">GND</text>
  <rect class="box" x="46" y="122" width="28" height="46" rx="3" style="opacity:.55" />
  <rect class="box" x="306" y="122" width="28" height="46" rx="3" style="opacity:.55" />
  <text class="lbl" x="60" y="150" text-anchor="middle">Q2</text>
