  <rect class="box" x="306" y="70" width="28" height="50" rx="3" />
  <path class="w" d="M180,30 V70 M180,120 V170 M240,30 V70 M240,120 V170" />
  <text class="lbl" x="60" y="100" text-anchor="middle">Q1</text>
  <text class="lbl" x="320" y="100" text-anchor="middle">Q3</text>
