  <text class="lbl" x="44" y="84" text-anchor="end">−20</text>
  <text class="lbl" x="44" y="104" text-anchor="end">−40</text>
  <text class="lbla" x="290" y="16" text-anchor="middle">f_g</text>
  <path class="gd" d="M290,20 V220" />
  <text class="lbla" x="450" y="82">−20 dB / Dekade</text>
  <path class="w" d="M50,140 V210 H580" />
  <path class="midl" d="M50,148 H200 C250,148 260,175 290,178 C320,181 340,200 400,202 H580" />
