    <tbody>
    <tr><td>H7 / k6</td><td>Übergangssitz</td><td>Leichter Schlag oder kleine Presse</td></tr>
    <tr><td>H7 / m6</td><td>Fester Übergangssitz</td><td>Presse; Verdrehsicherung ratsam</td></tr>
