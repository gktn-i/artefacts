  <rect class="box" x="116" y="44" width="10" height="18" /><rect class="box" x="116" y="78" width="10" height="18" />
  <rect class="box" x="272" y="44" width="10" height="18" /><rect class="box" x="272" y="78" width="10" height="18" />
  <rect class="accs" x="292" y="44" width="36" height="18" /><rect class="accs" x="292" y="78" width="36" height="18" />
  <rect class="box" x="338" y="44" width="10" height="18" /><rect class="box" x="338" y="78" width="10" height="18" />
  <path class="acc" d="M296,32 H324" />
  <polygon class="accf" points="300,28 300,36 291,32" />
  <polygon class="accf" points="320,28 320,36 329,32" />
  <text class="lbl" x="200" y="56" text-anchor="middle">Welle</text>
  <text class="lblb" x="98" y="118" text-anchor="middle">Festlager</text>
  <text class="lbl" x="98" y="134" text-anchor="middle">beidseitig angeschlagen</text>
  <text class="lblb" x="310" y="118" text-anchor="middle">Loslager</text>
  <text class="lbl" x="310" y="134" text-anchor="middle">axial frei im Gehäuse</text>
