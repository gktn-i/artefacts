<div class="tbl-wrap"><table style="min-width:640px">
<thead><tr><th>Farbe am Kabelschuh</th><th>Querschnitt</th><th>Hinweis</th></tr></thead>
<tbody>
<tr><td><span class="adn"><span class="ad r"></span>rot</span></td><td>etwa 0,5 bis 1,5 mm²</td><td>Aufdruck prüfen, Grenzen je Hersteller leicht verschieden</td></tr>
<tr><td><span class="adn"><span class="ad n"></span>blau</span></td><td>etwa 1,5 bis 2,5 mm²</td><td>Häufigste Größe im 12-V-Bereich</td></tr>
<tr><td><span class="adn"><span class="ad" style="--t:var(--ad-y)"></span>gelb</span></td><td>etwa 4 bis 6 mm²</td><td>Braucht eine kräftige Zange</td></tr>
<tr><td><b>unisoliert, Rohrkabelschuh</b></td><td>ab 6 mm²</td><td>Mit Sechskantpresse, darüber Schrumpfschlauch. Für Batterie und Wechselrichter</td></tr>
</tbody>
