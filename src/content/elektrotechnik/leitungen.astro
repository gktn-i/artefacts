<thead><tr><th data-s="num">Querschnitt</th><th data-s="num">Widerstand je m (Cu)</th><th>Belastbarkeit frei verlegt</th><th>Typische Verwendung</th></tr></thead>
<tbody>
<tr><td><b>0,14 mm²</b></td><td>0,125 Ω</td><td>~2 A</td><td>Signalleitungen, Sensorkabel</td></tr>
<tr><td><b>0,25 mm²</b></td><td>0,070 Ω</td><td>~4 A</td><td>Kleinsignale, Servokabel</td></tr>
