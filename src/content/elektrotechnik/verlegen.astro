  <path class="wt" d="M350,30 V206 M344,206 H356" style="stroke-dasharray:3 3" />
  <text class="lbl" x="358" y="190">80 cm unter</text>
  <text class="lbl" x="358" y="202">Einfahrt, Weg</text>
  <text class="lbl" x="114" y="100" text-anchor="end">Warnband</text>
  <text class="lbl" x="114" y="160" text-anchor="end">Sandbett</text>
  <text class="lbl" x="114" y="172" text-anchor="end">10 cm rundum</text>
  <text class="lbl" x="192" y="166">NYY-J</text>
  <text class="lblb" x="20" y="22">Oberfläche</text>
