      <path class="aGr" d="M100,96 H182" />
      <circle class="w" cx="235" cy="36" r="13" /><path class="w" d="M226,27 L244,45 M244,27 L226,45" />
      <circle class="w" cx="195" cy="96" r="13" /><path class="w" d="M186,87 L204,105 M204,87 L186,105" />
