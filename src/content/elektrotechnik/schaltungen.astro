      <path class="wt" d="M130,50 L190,90 M130,90 L190,50" style="stroke-dasharray:3 3" />
      <circle class="f" cx="236" cy="50" r="3" /><circle class="f" cx="236" cy="90" r="3" />
      <path class="w" d="M266,70 L239,53" /><circle class="f" cx="266" cy="70" r="3" />
      <path class="aS" d="M266,70 H286" />
      <circle class="w" cx="300" cy="70" r="14" /><path class="w" d="M290,60 L310,80 M310,60 L290,80" />
      <path class="aN" d="M314,70 H326 V132 H20" />
      <text class="lbl" x="10" y="74" text-anchor="middle">L</text>
      <text class="lbl" x="10" y="136" text-anchor="middle">N</text>
      <text class="lbl" x="71" y="114" text-anchor="middle">Wechsel</text>
      <text class="lbl" x="160" y="118" text-anchor="middle">Kreuz</text>
      <text class="lbl" x="251" y="114" text-anchor="middle">Wechsel</text>
      <text class="lsm" x="160" y="28" text-anchor="middle">je weiterer Ort ein Kreuzschalter</text>
    </svg>
    <div class="cd">Drei und mehr Schaltorte. Außen je ein Wechselschalter, dazwischen beliebig viele Kreuzschalter.</div>
  </div>
  <div class="card">
    <div class="ct">Taster mit Stromstoßschalter</div>
    <svg class="dg" viewBox="0 0 320 170" role="img" aria-label="Mehrere Taster parallel steuern die Spule eines Stromstoßschalters. Jeder Tastendruck schaltet dessen Kontakt um, der die Leuchte ein- oder ausschaltet.">
      <path class="aL" d="M24,30 H290 V50 M80,30 V48 M130,30 V48 M180,30 V48" />
