      <path class="aS" d="M290,72 V88" />
      <circle class="w" cx="290" cy="100" r="12" /><path class="w" d="M282,92 L298,108 M298,92 L282,108" />
      <path class="aN" d="M290,112 V150 H24" />
      <text class="lbl" x="14" y="34" text-anchor="middle">L</text>
      <text class="lbl" x="14" y="154" text-anchor="middle">N</text>
      <text class="lbl" x="130" y="108" text-anchor="middle">beliebig viele Taster</text>
      <text class="lbl" x="229" y="134" text-anchor="end">Stromstoßschalter</text>
