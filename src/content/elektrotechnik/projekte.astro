  <rect class="box" x="256" y="60" width="44" height="50" rx="4" style="stroke:var(--text)" />
  <rect class="badz" x="64" y="30" width="192" height="110" style="fill-opacity:.6" />
  <path class="aR" d="M64,70 H80 V30 H240 V70 H256" />
  <path class="aS" d="M64,100 H80 V140 H240 V100 H256" />
