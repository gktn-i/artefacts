  <text class="lbl" x="160" y="162" text-anchor="middle">fängt Störungen ein, strahlt ab</text>
  <rect class="box" x="360" y="60" width="44" height="50" rx="4" style="stroke:var(--text)" />
  <rect class="box" x="596" y="60" width="44" height="50" rx="4" style="stroke:var(--text)" />
