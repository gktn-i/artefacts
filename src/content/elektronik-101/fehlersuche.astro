<tr><td>Durchgebrannte Sicherung</td><td>Durchgang )))</td><td>aus</td><td>je eine Spitze an die <b>zwei Enden</b> der Sicherung</td><td><b>kein</b> Piep <span class="note" style="font-style:normal">(Piep wäre gut)</span></td><td>durch → warum? (meist Kurzschluss dahinter)</td></tr>
<tr><td>Lötbrücke zwischen Pins</td><td>Durchgang )))</td><td>aus</td><td>je eine Spitze auf <b>zwei benachbarte Pins</b></td><td><b>Piep</b> <span class="note" style="font-style:normal">(hier darf keiner kommen)</span></td><td>ungewollte Verbindung → unter der Lupe entfernen</td></tr>
