import "./_style.css";
---
<p class="lede">Stahl, Härte und Aufbau der Klinge. Die Härte in Rockwell (HRC) sagt mehr über ein Messer als jeder Markenname: sie bestimmt, wie fein die Schneide werden kann, wie lange sie hält und wie leicht sie ausbricht.</p>

<div class="kb-kpis">
  <div class="kb-kpi"><div class="v">HRC</div><div class="k">Rockwell-Härte</div><div class="s">Küchenmesser liegen zwischen 52 und 66. Jede Stufe zählt, ab 60 wird es „japanisch“.</div></div>
  <div class="kb-kpi"><div class="v">13 % Chrom</div><div class="k">macht Stahl rostfrei</div><div class="s">Carbonstahl hat fast keins: schärfer, rostet, bildet Patina.</div></div>
  <div class="kb-kpi"><div class="v">0,5 bis 1,4 %</div><div class="k">Kohlenstoff</div><div class="s">Mehr Kohlenstoff, mehr Härte. Weniger, mehr Zähigkeit.</div></div>
  <div class="kb-kpi"><div class="v">Pulverstahl</div><div class="k">feinste Körnung</div><div class="s">SG2, R2, ZDP-189: hart und trotzdem zäh, aber schwer zu schleifen.</div></div>
</div>

<figure class="kb-fig">
  <div class="kb-title">Klingenhärte im Vergleich · typische Serien</div>
  <div class="kb-bars-wrap has-top">
    <div class="kb-vline" style="--f:0.444"><b>58 · Wetzstahl-Grenze</b></div>
    <div class="kb-vline" style="--f:0.667"><b>62 · Carbon</b></div>
    <div class="kb-bars">
      <div class="kb-brow"><div class="nm">Billigmesser<small>1.4034 · 420</small></div><div class="kb-track"><div class="kb-fill bad" style="--w:17%"><b>52–55</b></div></div></div>
      <div class="kb-brow"><div class="nm">Victorinox Fibrox<small>X50CrMoV15</small></div><div class="kb-track"><div class="kb-fill" style="--w:33%"><b>56</b></div></div></div>
      <div class="kb-brow"><div class="nm">Zwilling Pro<small>X50CrMoV15</small></div><div class="kb-track"><div class="kb-fill" style="--w:39%"><b>57</b></div></div></div>
      <div class="kb-brow"><div class="nm">Wüsthof Classic<small>X50CrMoV15</small></div><div class="kb-track"><div class="kb-fill" style="--w:44%"><b>58</b></div></div></div>
      <div class="kb-brow"><div class="nm">Global<small>Cromova 18</small></div><div class="kb-track"><div class="kb-fill" style="--w:44%"><b>56–58</b></div></div></div>
      <div class="kb-brow"><div class="nm">Tojiro DP<small>VG10</small></div><div class="kb-track"><div class="kb-fill wet" style="--w:56%"><b>60</b></div></div></div>
      <div class="kb-brow"><div class="nm">Shun Classic<small>VG-MAX</small></div><div class="kb-track"><div class="kb-fill wet" style="--w:61%"><b>61</b></div></div></div>
      <div class="kb-brow"><div class="nm">Shirogami #2<small>Carbon, White</small></div><div class="kb-track"><div class="kb-fill wet" style="--w:72%"><b>62–64</b></div></div></div>
      <div class="kb-brow"><div class="nm">Miyabi 5000MCD<small>SG2 Pulver</small></div><div class="kb-track"><div class="kb-fill wet" style="--w:72%"><b>63</b></div></div></div>
      <div class="kb-brow"><div class="nm">Aogami Super<small>Carbon, Blue</small></div><div class="kb-track"><div class="kb-fill wet in" style="--w:81%"><b>64–65</b></div></div></div>
      <div class="kb-brow"><div class="nm">ZDP-189<small>Pulver</small></div><div class="kb-track"><div class="kb-fill wet in" style="--w:86%"><b>65–66</b></div></div></div>
    </div>
  </div>
  <div class="kb-legend"><span><i class="dry"></i>westlich</span><span><i class="wet"></i>japanisch</span><span><i class="bad"></i>zu weich</span></div>
  <figcaption>Skala 50 bis 68 HRC. Bis etwa 58 lässt sich die Schneide mit dem Wetzstahl aufrichten. Darüber ist der Stahl so hart, dass er beim Wetzen ausbricht statt sich zu biegen: Wasserstein statt Stahl.</figcaption>
</figure>

<div class="block">
  <div class="section-label">Die wichtigsten Küchenmesserstähle</div>
  <div class="kb-tbl-wrap">
    <table class="kb-table">
      <thead><tr><th>Stahl</th><th>Typ</th><th class="c">HRC</th><th class="c">Rostfrei</th><th>Schärfen</th><th>Hält</th><th>Typisch</th></tr></thead>
      <tbody>
        <tr><td>X50CrMoV15<small>1.4116</small></td><td>rostfrei, westlich</td><td class="m c">55–58</td><td class="c"><span class="y">ja</span></td><td>sehr leicht</td><td class="c"><span class="p">mittel</span></td><td>Wüsthof, Zwilling, Victorinox</td></tr>
        <tr><td>14C28N · AEB-L</td><td>rostfrei, feinkörnig</td><td class="m c">58–61</td><td class="c"><span class="y">ja</span></td><td>leicht</td><td class="c"><span class="y">gut</span></td><td>skandinavische und Custom-Messer</td></tr>
        <tr><td>AUS-8 · AUS-10</td><td>rostfrei, japanisch</td><td class="m c">58–61</td><td class="c"><span class="y">ja</span></td><td>leicht</td><td class="c"><span class="p">mittel</span></td><td>günstige japanische Serien</td></tr>
        <tr><td>VG10</td><td>rostfrei, japanisch</td><td class="m c">60–61</td><td class="c"><span class="y">ja</span></td><td>mittel</td><td class="c"><span class="y">gut</span></td><td>Tojiro DP, Shun, Kai Shun</td></tr>
        <tr><td>Ginsan<small>Silver 3</small></td><td>rostfrei, wie Carbon im Verhalten</td><td class="m c">60–62</td><td class="c"><span class="y">ja</span></td><td>leicht</td><td class="c"><span class="y">gut</span></td><td>rostfreie Alternative zu Shirogami</td></tr>
        <tr><td>SG2 · R2</td><td>rostfrei, Pulver</td><td class="m c">63–64</td><td class="c"><span class="y">ja</span></td><td>schwer</td><td class="c"><span class="y">sehr gut</span></td><td>Miyabi, Takamura, Shun Kaji</td></tr>
        <tr><td>ZDP-189</td><td>rostfrei, Pulver</td><td class="m c">65–66</td><td class="c"><span class="y">ja</span></td><td>sehr schwer</td><td class="c"><span class="y">exzellent</span></td><td>High-End, selten</td></tr>
        <tr><td>Shirogami #1 · #2<small>White Paper</small></td><td>Carbon, rein</td><td class="m c">61–64</td><td class="c"><span class="n">nein</span></td><td>sehr leicht</td><td class="c"><span class="y">gut</span></td><td>traditionelle Schmieden, Sushi-Messer</td></tr>
        <tr><td>Aogami #2 · Super<small>Blue Paper</small></td><td>Carbon mit Wolfram, Chrom</td><td class="m c">62–65</td><td class="c"><span class="n">nein</span></td><td>leicht</td><td class="c"><span class="y">sehr gut</span></td><td>Takeda, Moritaka, Kurouchi-Messer</td></tr>
        <tr><td>1.4034 · 420</td><td>rostfrei, billig</td><td class="m c">52–55</td><td class="c"><span class="y">ja</span></td><td>sehr leicht</td><td class="c"><span class="n">schwach</span></td><td>Messerblöcke unter 50 €</td></tr>
      </tbody>
    </table>
  </div>
  <div class="note">Carbonstahl (Shirogami, Aogami) wird schärfer als jeder rostfreie Stahl und ist in Minuten geschliffen. Dafür rostet er, wenn er nass liegen bleibt, und verfärbt Zwiebeln und Äpfel, bis die Patina da ist. Wer sich das nicht antun will, nimmt Ginsan oder SG2.</div>
</div>

<div class="block">
  <div class="section-label">Aufbau der Klinge</div>
  <div class="kb-tbl-wrap">
    <table class="kb-table">
      <thead><tr><th>Bauart</th><th>Was es ist</th><th>Vorteil</th><th>Nachteil</th></tr></thead>
      <tbody>
        <tr><td>Monostahl</td><td>eine Stahlsorte durch und durch</td><td>einfach, ehrlich, günstig bis teuer</td><td>harter Stahl ist dann überall spröde</td></tr>
        <tr><td>San-Mai<small>3 Lagen</small></td><td>harter Kern zwischen zwei weichen Lagen</td><td>hart an der Schneide, zäh im Rücken, leicht zu schleifen</td><td>Kern kann bei Carbon rosten</td></tr>
        <tr><td>Damast<small>Suminagashi</small></td><td>viele Lagen um einen Kern (meist VG10 oder SG2)</td><td>Optik, sonst wie San-Mai</td><td>Aufpreis nur fürs Muster; „Damast“ als Ätzung ist Betrug</td></tr>
        <tr><td>Kurouchi</td><td>schwarze Schmiedehaut bleibt auf der Klinge</td><td>rostet weniger, rustikal, günstiger</td><td>färbt anfangs ab, nutzt sich ab</td></tr>
        <tr><td>Tsuchime</td><td>Hammerschlag-Oberfläche</td><td>weniger Anhaften von Scheiben</td><td>reine Optik bei billigen Messern</td></tr>
        <tr><td>Kullenschliff</td><td>Mulden entlang der Klinge</td><td>Luft zwischen Klinge und Scheibe</td><td>wirkt nur bei weichem, feuchtem Gut</td></tr>
        <tr><td>Honyaki</td><td>differenziell gehärteter Monostahl wie ein Schwert</td><td>höchste Schärfe, Hamon-Linie</td><td>spröde, teuer, nur für Profis</td></tr>
      </tbody>
    </table>
  </div>
</div>

<div class="note">Das Stahldreieck aus Schnitthaltigkeit, Zähigkeit und Rostfreiheit samt Datenbank mit über 40 Stählen steht im <a href="messer.html#stahl">Messer-Modul</a>.</div>
