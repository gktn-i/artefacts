        <tr><td class="sil"><svg class="km" viewBox="0 0 300 58" aria-hidden="true"><path class="hd wa" d="M4,21 L68,22 L68,36 L4,37 Z"/><rect class="fe" x="68" y="21" width="12" height="15" rx="1"/><path class="bl jpn" d="M80,10 L171,10 C177,10 183,14 185,18 C169,28 135,40 80,42 Z"/></svg></td><td>Honesuki<small>骨すき · Knochenschäler</small></td><td class="m">14–16 cm</td><td>einseitig oder 70/30</td><td>Dreieckig, steif. Geflügel zerlegen, an Gelenken entlang. Nicht durch Knochen hacken.</td><td>Geflügel</td></tr>
