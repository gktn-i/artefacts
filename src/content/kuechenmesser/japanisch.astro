<div class="block">
  <div class="section-label">Einseitig geschliffen (Kataba) · traditionelle Spezialisten</div>
  <div class="kb-tbl-wrap">
    <table class="kb-table">
      <thead><tr><th></th><th>Messer</th><th>Klinge</th><th>Schliff</th><th>Wofür</th><th>Für wen</th></tr></thead>
      <tbody>
        <tr><td class="sil"><svg class="km" viewBox="0 0 300 58" aria-hidden="true"><path class="hd wa" d="M4,21 L68,22 L68,36 L4,37 Z"/><rect class="fe" x="68" y="21" width="12" height="15" rx="1"/><path class="bl jpn" d="M80,10 L170,10 C190,10 202,16 206,20 C198,34 150,44 80,46 Z"/></svg></td><td>Deba<small>出刃</small></td><td class="m">15–21 cm</td><td>einseitig (Kataba)</td><td>Dick und schwer (5–9 mm am Rücken). Fisch zerlegen, Köpfe, Gräten. Kein Gemüsemesser.</td><td>Fischküche</td></tr>
        <tr><td class="sil"><svg class="km" viewBox="0 0 300 58" aria-hidden="true"><path class="hd wa" d="M4,21 L68,22 L68,36 L4,37 Z"/><rect class="fe" x="68" y="21" width="12" height="15" rx="1"/><path class="bl jpn" d="M80,16 L261,14 C266,14 269,16 269,18 C257,26 179,34 80,36 Z"/></svg></td><td>Yanagiba<small>柳刃 · Weidenblatt</small></td><td class="m">24–33 cm</td><td>einseitig (Kataba)</td><td>Sashimi und Sushi in einem einzigen Zug. Sehr dünn, sehr lang, hauchdünne Scheiben.</td><td>Sushi, rohe Fisch</td></tr>
