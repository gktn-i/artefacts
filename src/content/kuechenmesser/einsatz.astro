---
import "./_style.css";
---
<p class="lede">Welches Messer für welche Aufgabe. Die Matrix zeigt, was ideal ist, was geht und was dem Messer schadet.</p>

<div class="block">
  <div class="section-label">Aufgabe gegen Messer</div>
  <div class="kb-tbl-wrap">
    <table class="kb-table">
      <thead><tr><th>Aufgabe</th><th class="c">Kochmesser / Gyuto</th><th class="c">Santoku / Bunka</th><th class="c">Nakiri / Usuba</th><th class="c">Petty / Office</th><th class="c">Brotmesser</th><th class="c">Sujihiki / Tranchier / Filetier</th><th class="c">Honesuki / Ausbein</th><th class="c">Deba / Beil</th></tr></thead>
      <tbody>
        <tr><td>Zwiebeln, Kräuter wiegen</td><td class="c"><span class="y">✓✓</span></td><td class="c"><span class="y">✓</span></td><td class="c"><span class="p">~</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td></tr>
        <tr><td>Gemüse Scheiben, Julienne</td><td class="c"><span class="y">✓</span></td><td class="c"><span class="y">✓✓</span></td><td class="c"><span class="y">✓✓</span></td><td class="c"><span class="p">~</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="p">~</span></td></tr>
        <tr><td>Kürbis, Sellerie, Hartes</td><td class="c"><span class="y">✓</span></td><td class="c"><span class="p">~</span></td><td class="c"><span class="p">~</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="p">~</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="y">✓</span></td></tr>
        <tr><td>Fleisch portionieren</td><td class="c"><span class="y">✓✓</span></td><td class="c"><span class="y">✓</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="p">~</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="y">✓</span></td><td class="c"><span class="y">✓</span></td><td class="c"><span class="p">~</span></td></tr>
        <tr><td>Braten tranchieren</td><td class="c"><span class="y">✓</span></td><td class="c"><span class="p">~</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="p">~</span></td><td class="c"><span class="y">✓✓</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td></tr>
        <tr><td>Fisch filetieren</td><td class="c"><span class="p">~</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="p">~</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="y">✓✓</span></td><td class="c"><span class="p">~</span></td><td class="c"><span class="y">✓✓</span></td></tr>
        <tr><td>Sashimi, hauchdünn</td><td class="c"><span class="p">~</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="y">✓ Sujihiki · ✓✓ Yanagiba</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td></tr>
        <tr><td>Geflügel zerlegen, Gelenke</td><td class="c"><span class="p">~</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="y">✓✓</span></td><td class="c"><span class="y">✓</span></td></tr>
        <tr><td>Knochen durchtrennen</td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="y">✓✓ Beil</span></td></tr>
        <tr><td>Obst schälen, Knoblauch</td><td class="c"><span class="p">~</span></td><td class="c"><span class="p">~</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="y">✓✓</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td></tr>
        <tr><td>Brot, Kruste</td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="y">✓✓</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td></tr>
        <tr><td>Tomaten, Weiches mit Haut</td><td class="c"><span class="y">✓ scharf</span></td><td class="c"><span class="y">✓</span></td><td class="c"><span class="y">✓</span></td><td class="c"><span class="y">✓</span></td><td class="c"><span class="y">✓</span></td><td class="c"><span class="y">✓</span></td><td class="c"><span class="n">✗</span></td><td class="c"><span class="n">✗</span></td></tr>
      </tbody>
    </table>
  </div>
  <div class="kb-legend"><span><span class="y">✓✓</span> ideal</span><span><span class="y">✓</span> gut</span><span><span class="p">~</span> geht</span><span><span class="n">✗</span> falsches Werkzeug oder schadet</span></div>
</div>

<div class="block">
  <div class="section-label">Was welchem Messer schadet</div>
  <div class="kb-tbl-wrap">
    <table class="kb-table">
      <thead><tr><th>Tabu</th><th>Warum</th><th>Stattdessen</th></tr></thead>
      <tbody>
        <tr><td>Knochen mit Gyuto oder Santoku</td><td>harter Stahl bricht aus, Scharte bleibt bis zum nächsten Grobschliff</td><td>Beil, Deba oder Honesuki an den Gelenken entlang</td></tr>
        <tr><td>Gefrorenes</td><td>wie Knochen, dazu Kälte macht Stahl spröder</td><td>antauen lassen oder Brotmesser</td></tr>
        <tr><td>Hebeln, Verkanten</td><td>dünne Klingen verbiegen oder brechen</td><td>gerade durchschneiden, Kürbis erst halbieren</td></tr>
        <tr><td>Mit der Schneide schaben</td><td>rollt die Schneide um, stumpf in Minuten</td><td>Klingenrücken zum Zusammenschieben nutzen</td></tr>
        <tr><td>Glas-, Stein-, Keramikbrett</td><td>härter als jeder Stahl, ruiniert jede Schneide</td><td>Holz (Hirnholz ideal) oder Kunststoff</td></tr>
        <tr><td>Spülmaschine</td><td>Hitze, Chemie, Klappern gegen Besteck; Holzgriffe reißen</td><td>warm abspülen, sofort trocknen</td></tr>
        <tr><td>Wetzstahl auf 60+ HRC</td><td>Stahl zu hart, bricht mikroskopisch aus statt sich aufzurichten</td><td>Keramik-Wetzstab leicht oder Wasserstein</td></tr>
      </tbody>
    </table>
  </div>
</div>

<div class="block">
  <div class="section-label">Schnitttechniken · welche Form kann was</div>
  <div class="ratio-grid">
    <div class="ratio-item"><span class="r-label">Wiegeschnitt</span><div class="r-value">Bauch</div><div class="r-sub">Spitze bleibt am Brett, Klinge rollt ab. Kochmesser, Kräuter, Zwiebeln.</div></div>
    <div class="ratio-item"><span class="r-label">Zugschnitt</span><div class="r-value">Länge</div><div class="r-sub">Klinge zieht beim Senken nach hinten. Gyuto, Sujihiki, Fleisch, Tomaten.</div></div>
    <div class="ratio-item"><span class="r-label">Druckschnitt</span><div class="r-value">Gerade</div><div class="r-sub">Senkrecht nach unten, Klinge ganz auf. Nakiri, Santoku, Gemüse.</div></div>
    <div class="ratio-item"><span class="r-label">Hackschnitt</span><div class="r-value">Masse</div><div class="r-sub">Schwung aus dem Handgelenk. Beil, Deba, Cai Dao.</div></div>
    <div class="ratio-item"><span class="r-label">Krallengriff</span><div class="r-value">Finger</div><div class="r-sub">Fingerkuppen eingerollt, Klinge liegt am Knöchel. Schützt und führt.</div></div>
    <div class="ratio-item"><span class="r-label">Pinch-Grip</span><div class="r-value">Zange</div><div class="r-sub">Daumen und Zeigefinger fassen die Klinge vor dem Griff. Kontrolle statt Kraft.</div></div>
  </div>
</div>
