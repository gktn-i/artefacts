<thead><tr><th data-s="text">Paarung</th><th data-s="num">µ trocken (Haft)</th><th data-s="num">µ trocken (Gleit)</th><th data-s="num">µ geschmiert</th></tr></thead>
<tbody>
<tr><td>Stahl auf Stahl</td><td>0,15 – 0,25</td><td>0,10 – 0,20</td><td>0,05 – 0,10</td></tr>
