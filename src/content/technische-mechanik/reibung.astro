<tr><td>Stahl auf Bronze</td><td>0,15 – 0,20</td><td>0,12 – 0,18</td><td>0,04 – 0,08</td></tr>
<tr><td>Stahl auf PTFE</td><td>0,04 – 0,10</td><td>0,04 – 0,08</td><td>0,04</td></tr>
<tr><td>Stahl auf POM</td><td>0,15 – 0,25</td><td>0,15 – 0,20</td><td>0,05 – 0,10</td></tr>
