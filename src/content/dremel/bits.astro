<h2>Bits & Aufsätze</h2>
<p style="font-size:12px;color:#888;margin-bottom:.6rem">Zeile antippen für Aussehen und Erkennungsmerkmale.</p>
<input class="search" id="search-bits" placeholder="Suche Bit, Nummer, Material…">
<div class="filt" id="filt-bits">
<button class="active" data-f="all">Alle</button>
<button data-f="cut">Trennen</button>
<button data-f="grind">Schleifen</button>
<button data-f="carve">Fräsen/Schnitzen</button>
<button data-f="sand">Schmirgeln</button>
<button data-f="pol">Polieren</button>
<button data-f="clean">Reinigen/Bürsten</button>
<button data-f="drill">Bohren</button>
</div>
<div class="tbl-wrap">
<table id="t-bits">
<thead><tr>
<th data-k="name">Bit / Aufsatz<span class="ar"></span></th>
<th data-k="nr">Nr.<span class="ar"></span></th>
<th data-k="cat">Kategorie<span class="ar"></span></th>
<th data-k="for">Material</th>
<th data-k="rpm">Drehzahl<span class="ar"></span></th>
</tr></thead>
<tbody id="bits-body"></tbody>
</table>
</div>
