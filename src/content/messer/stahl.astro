<thead><tr><th data-s="text">Stahl</th><th data-s="num">Austenitisieren</th><th>Abschrecken</th><th>Kryo</th><th>Anlassen (niedrig)</th><th>Erreichbar</th></tr></thead>
<tbody>
<tr><td><b>1095</b></td><td>790–815 °C</td><td>schnelles Öl (Parks 50) oder Wasser</td><td>optional</td><td>175–205 °C</td><td>62–66 HRC vor, 58–62 nach dem Anlassen</td></tr>
<tr><td><b>1084 / 80CrV2</b></td><td>800–830 °C</td><td>Öl</td><td>optional</td><td>175–200 °C</td><td>60–63 HRC</td></tr>
<tr><td><b>52100</b></td><td>830–860 °C</td><td>Öl</td><td>empfohlen</td><td>175–200 °C</td><td>61–64 HRC</td></tr>
<tr><td><b>O1</b></td><td>790–815 °C</td><td>Öl</td><td>optional</td><td>175–200 °C</td><td>62–64 HRC</td></tr>
<tr><td><b>A2</b></td><td>925–980 °C</td><td>Luft / Platten</td><td>empfohlen</td><td>175–205 °C</td><td>60–62 HRC</td></tr>
<tr><td><b>D2</b></td><td>1010–1040 °C</td><td>Luft / Platten</td><td>empfohlen</td><td>200 °C oder 500–540 °C</td><td>60–62 HRC</td></tr>
<tr><td><b>CPM 3V</b></td><td>1010–1065 °C</td><td>Platten, Luft</td><td>empfohlen</td><td>200 °C oder 510–540 °C</td><td>58–62 HRC</td></tr>
