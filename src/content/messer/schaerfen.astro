import "./_style.css";
---
<div class="kurz z"><b>Grob macht scharf, fein macht schön, der Grat muss weg.</b> Ein Stein, ein Winkel, den man hält, und das Erkennen des Grats reichen für jedes Messer.</div>

<h2>Winkel</h2>
<figure>
<svg class="dg m" viewBox="0 0 440 200" role="img" aria-label="Klinge liegt im Winkel alpha auf einem Schleifstein; die Höhe des Rückens über dem Stein ergibt sich aus Klingenhöhe mal Sinus des Winkels; daneben die Definition von Winkel je Seite und inklusivem Winkel an einem Schneidenquerschnitt">
  <rect class="box" x="20" y="150" width="220" height="30" rx="4" />
  <text class="lbl" x="130" y="170" text-anchor="middle">Schleifstein</text>
  <path class="accs" d="M60,150 L200,86 L206,92 L64,152 Z" />
  <path class="gd" d="M200,86 V150" />
  <text class="lbl" x="208" y="122">h = b · sin(α)</text>
  <path class="acc" d="M60,150 A40,40 0 0 0 96,134" /><text class="lbla" x="104" y="140">α</text>
  <text class="lbl" x="130" y="102" text-anchor="middle" transform="rotate(-25 130 102)">Klingenhöhe b</text>
  <!-- Querschnitt -->
  <path class="box" d="M300,30 L360,30 L340,170 L320,170 Z" />
  <path class="wt" d="M330,170 V60" />
  <path class="acc" d="M330,130 A40,40 0 0 1 336,131" />
  <text class="lbla" x="342" y="128">α je Seite</text>
  <path class="acc" d="M310,140 A45,45 0 0 1 350,140" />
  <text class="lbla" x="330" y="190" text-anchor="middle">2α inklusiv</text>
</svg>
<figcaption>Links: Freihand ist der Winkel die Rückenhöhe über dem Stein. Rechts: „15°“ kann je Seite oder inklusiv gemeint sein — bei Spyderco je Seite, beim Sharpmaker („30°/40°“) inklusiv.</figcaption>
</figure>
