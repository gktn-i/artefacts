<div class="calc" data-calc="schaerfwinkel">
  <h4>Rückenhöhe, Fasenbreite, Münzlehre</h4>
  <div class="row">
    <div><label>Winkel je Seite (°)</label><input type="number" data-k="winkel" value="15" step="0.5" /></div>
    <div><label>Klingenhöhe (mm, Rücken bis Schneide)</label><input type="number" data-k="breite" value="30" step="1" /></div>
    <div><label>Dicke hinter der Schneide (mm)</label><input type="number" data-k="bte" value="0.5" step="0.05" placeholder="optional" /></div>
  </div>
  <div class="out" data-out></div>
