---
import "./_style.css";
import RateTable from "../../components/RateTable.astro";

/* Kennwerte r = [Festigkeit, Tempo, Materialeffizienz, Isotropie], 1–10. */
const CATS = [
  { id: "allround", l: "Allrounder", c: "#2fb57a" },
  { id: "stark", l: "Stark", c: "#3d8bf0" },
  { id: "schnell", l: "Schnell", c: "#e2ac2a" },
  { id: "spezial", l: "Spezialisiert", c: "#a06cf2" },
];
const METRICS = [
  { l: "Festigkeit", d: "Tragfähigkeit bei gleicher Dichte", c: "#3d8bf0" },
  { l: "Tempo", d: "wie schnell das Muster druckt", c: "#e2ac2a" },
  { l: "Effizienz", d: "Festigkeit je Gramm Material", c: "#2fb57a" },
  { l: "Isotropie", d: "gleich stark in alle Richtungen", c: "#a06cf2" },
];
const PRE = [
  { l: "Dichte", key: "dichte", sort: "num" },
  { l: "Dim.", key: "dim" },
];
const COLS = [
  { l: "Charakter", key: "t", w: 260 },
  { l: "Wofür konkret", key: "w", w: 300 },
];
const ROWS = [
  {"n": "Gyroid", "cat": "allround", "k": "gyroid isotrop standard funktionsteil cf gf outdoor allround", "top": "Top", "dichte": "10–30 %", "dim": "3D", "r": [9, 7, 8, 10], "t": "Geschwungene Flächen, die sich innerhalb einer Schicht nie kreuzen: gleich stark in alle Richtungen, wenig Vibration. Die Standardempfehlung von Bambu Lab und Prusa und die richtige Antwort, wenn man nicht nachdenken will.", "w": ["Drohnenarme, Fahrradhalter, Teile aus CF-Filament, Griffe aus TPU", "Cubic", "gleich stark in jede Richtung, auch wenn die Last schräg kommt"]},
  {"n": "Grid (Gitter)", "cat": "schnell", "k": "grid gitter kreuzgitter schnell prototyp gehaeuse box standard", "top": "Top", "dichte": "10–30 %", "dim": "2D", "r": [6, 9, 5, 4], "t": "Einfaches Kreuzgitter, sehr schnell und zuverlässig, gute Stützung der Deckschichten. Tragfähig in X und Y, schwach diagonal; die Linien kreuzen sich auf derselben Schicht und der Kopf rumpelt darüber.", "w": ["Kisten, Gehäuse, Testdrucke, Kabelkanäle", "Gyroid", "deutlich schneller, wenn die Last nur von oben kommt"]},
  {"n": "Lightning", "cat": "schnell", "k": "lightning baumfoermig minimal deko figur vase cosplay materialsparen", "top": "Top", "dichte": "5–15 %", "dim": "adaptiv", "r": [2, 10, 10, 1], "t": "Baumartige Verästelungen, die nur dort wachsen, wo Deckschichten Auflage brauchen. Spart bis zu zwei Drittel Material und Zeit — trägt dafür praktisch nichts. Für Figuren, Vasen und reine Optik.", "w": ["Figuren, Vasen, Cosplay-Deko, Architekturmodelle", "Grid", "spart bis zu zwei Drittel Material und Zeit"]},
  {"n": "Cubic (Würfel)", "cat": "stark", "k": "cubic wuerfel 3d druckfest zahnrad halterung funktionsteil", "top": "Top", "dichte": "15–30 %", "dim": "3D", "r": [8, 6, 7, 8], "t": "Um 45° gekippte Würfel mit geschlossenen Lufttaschen: gute Festigkeit in alle Richtungen und spürbar schneller als Waben. Die Wahl, wenn Gyroid zu lange braucht.", "w": ["Wandhalter, Halter für Zahnräder, Werkzeuggriffe", "Gyroid", "fast so stark und spürbar schneller"]},
  {"n": "CrossHatch", "cat": "schnell", "k": "crosshatch bambu studio speed schnell funktionsprototyp leise", "top": "Top", "dichte": "10–25 %", "dim": "2D", "r": [5, 9, 6, 4], "t": "Neueres Bambu-Muster für hohe Geschwindigkeit: keine Kreuzungen innerhalb einer Schicht, dadurch ruhiger Lauf. Stabiler als Lines, schwächer als Gyroid oder Cubic.", "w": ["Schnelle Funktionsprototypen, Gehäuse, Halter ohne große Last", "Grid", "leiser und ruhiger beim Druck, dazu etwas stabiler"]},
  {"n": "Honeycomb (Waben)", "cat": "stark", "k": "honeycomb waben lastverteilung leichtbau drohne sandwich", "top": null, "dichte": "15–30 %", "dim": "2D", "r": [8, 4, 7, 6], "t": "Das klassische Wabenmuster mit exzellenter Lastverteilung je Gramm. Bezahlt wird das mit vielen scharfen Richtungswechseln und entsprechend langer Druckzeit.", "w": ["Leichte Platten für RC-Modelle, Sandwichplatten, Böden von Kisten", "Gyroid", "verteilt Druck auf Flächen sehr gut"]},
  {"n": "Adaptive Cubic", "cat": "stark", "k": "adaptive cubic dichte anpassung materialsparen grosse teile", "top": null, "dichte": "10–25 %", "dim": "3D", "r": [7, 7, 9, 7], "t": "Cubic mit automatisch variabler Dichte: dicht an Wänden und unter Deckschichten, dünn im Kern. Spart bei großen Teilen viel Material, die Festigkeit wird dafür schlechter vorhersagbar.", "w": ["Große Gehäuse, Helme, Spielzeug mit dicken Wänden", "Cubic", "spart im Kern großer Teile viel Material"]},
  {"n": "3D Honeycomb", "cat": "stark", "k": "3d honeycomb waben dreidimensional maximal belastet industrie", "top": null, "dichte": "15–30 %", "dim": "3D", "r": [9, 3, 6, 7], "t": "Waben mit Z-Verstrebung und damit eines der stärksten Muster überhaupt. Sehr lange Druckzeit durch komplexe Pfade — nur für Teile, die es wirklich brauchen.", "w": ["Hoch belastete Halter, Klemmen, Teile mit Last aus allen Richtungen", "Gyroid", "noch stabiler, wenn die Druckzeit egal ist"]},
  {"n": "Lines (Linien)", "cat": "schnell", "k": "lines linien rectilinear schnell visuell miniatur", "top": null, "dichte": "10–20 %", "dim": "2D", "r": [3, 9, 7, 2], "t": "Parallele Bahnen, je Schicht um 90° gedreht. Schnell und leise, aber innerhalb einer Schicht nur in einer Richtung tragfähig. Für schnelle Sichtprototypen und Miniaturen.", "w": ["Miniaturen, Sichtmodelle, schnelle Passproben", "Grid", "noch schneller, keine Kreuzungen auf einer Schicht"]},
  {"n": "Triangles (Dreiecke)", "cat": "stark", "k": "triangles dreiecke scherfestigkeit platte flaeche", "top": null, "dichte": "15–30 %", "dim": "2D", "r": [8, 6, 6, 5], "t": "Dreiecksnetz mit sehr guter Scherfestigkeit in der Ebene, ohne Verstrebung in Z. Gut für Platten und flächige Bauteile, die seitlich belastet werden.", "w": ["Grundplatten, Deckel, flache Halter mit seitlicher Last", "Grid", "steifer gegen Verschieben in der Ebene"]},
  {"n": "Concentric (Konzentrisch)", "cat": "spezial", "k": "concentric konzentrisch flexibel tpu duennwandig feder", "top": null, "dichte": "15–40 %", "dim": "2D", "r": [4, 7, 6, 3], "t": "Folgt der Außenkontur nach innen und lässt das Teil federn statt tragen. Für flexible Teile und dünnwandige Behälter; als Auflage für Deckschichten ungeeignet.", "w": ["TPU-Handyhüllen, flexible Armbänder, dünnwandige Becher", "Gyroid", "das Teil federt gleichmäßig, statt steif zu tragen"]},
  {"n": "Zig-Zag", "cat": "schnell", "k": "zigzag zick zack durchgehend keine retraction schnell testdruck", "top": null, "dichte": "10–20 %", "dim": "2D", "r": [3, 9, 7, 2], "t": "Wie Lines, aber als durchgehender Pfad ohne Rückzüge. Gleiche Festigkeit, weniger Retraction-Probleme — praktisch bei Materialien, die beim Rückzug zicken.", "w": ["Drucke mit PETG oder TPU, bei denen Rückzüge Fäden ziehen", "Lines", "weniger Rückzüge und damit weniger Fäden"]},
  {"n": "Tri-Hexagon", "cat": "stark", "k": "trihexagon dreieck sechseck platte struktur abdeckung", "top": null, "dichte": "15–30 %", "dim": "2D", "r": [8, 5, 6, 6], "t": "Dreiecke und Sechsecke kombiniert: sehr tragfähig in der Ebene bei guter Lastverteilung. Viele Richtungswechsel, entsprechend langsam.", "w": ["Abdeckungen, Gehäuseplatten, flache Strukturteile", "Triangles", "verteilt Last etwas gleichmäßiger"]},
  {"n": "Cross (Kreuz)", "cat": "spezial", "k": "cross kreuz flexibel tpu tpe daempfer polster", "top": null, "dichte": "10–25 %", "dim": "2D", "r": [3, 6, 7, 3], "t": "Kreuzmuster, das dem Teil gezielt Nachgiebigkeit gibt. Sinnvoll fast nur in Kombination mit TPU oder TPE für Dämpfer und Polster.", "w": ["TPU-Dämpfer, Polster, weiche Griffe", "Concentric", "gleich nachgiebig in alle Richtungen"]},
  {"n": "Locked Zag", "cat": "spezial", "k": "locked zag bambu skin skeleton seitenflaeche optik duennwandig", "top": null, "dichte": "15–30 %", "dim": "2D", "r": [6, 7, 6, 4], "t": "Bambu-Muster aus zwei Lagen: eine Cross-Zag-Haut für die Seitenflächen und ein Zig-Zag-Skelett für die Festigkeit, beide getrennt einstellbar. Für Teile, bei denen das Muster durchscheinen soll.", "w": ["Lampenschirme und dünnwandige Teile, durch die das Infill scheint", "Gyroid", "die Seitenflächen sehen sauberer aus"]},
  {"n": "Support Cubic", "cat": "schnell", "k": "support cubic sparsam deckschicht deko materialsparen", "top": null, "dichte": "5–15 %", "dim": "3D", "r": [4, 8, 9, 5], "t": "Auf Deckschicht-Stützung reduziertes Cubic — dasselbe Ziel wie Lightning, aber als räumliche Struktur und damit etwas tragfähiger. Für leichte Sichtteile mit sauberer Oberseite.", "w": ["Deko-Boxen, Figurensockel, Teile mit großer Oberseite ohne Last", "Lightning", "die Deckschicht wird sauberer gestützt"]},
];
---
<div class="kurz"><b>Das Infill-Muster entscheidet, wofür das Material im Inneren überhaupt gut ist.</b> 2D-Muster wiederholen sich Schicht für Schicht und tragen nur in der Ebene; 3D-Muster verschränken sich über die Schichten hinweg und tragen in alle Richtungen. Fünf Muster decken den Alltag ab — der Rest ist Sonderfall.</div>

<h2>Alle Muster im Vergleich</h2>
<p>Namen und Kategorien folgen Bambu Studio; PrusaSlicer, OrcaSlicer und Cura kennen dieselben Muster meist unter gleichem oder sehr ähnlichem Namen. <span class="b acc">Top</span> markiert die fünf Muster, mit denen sich praktisch jeder Druck erschlagen lässt.</p>
<RateTable cats={CATS} metrics={METRICS} pre={PRE} cols={COLS} rows={ROWS} list="Mustern" search="Suchen: Muster, Eigenschaft, Anwendung …" minWidth={1180} first="Muster" />
</div>
<div class="note">Einzustellen in Bambu Studio unter Process → Strength → Sparse Infill Pattern, in PrusaSlicer unter Druckeinstellungen → Füllung.</div>

<h2>Dichte richtig wählen</h2>
<p>Mehr Füllung ist selten die richtige Antwort: oberhalb von rund 40–50 % bringt eine zusätzliche Wand mehr Festigkeit je Gramm als noch mehr Infill, weil die Last überwiegend über die Außenkontur läuft.</p>
<div class="tbl-wrap"><table style="min-width:720px">
  <thead><tr><th data-s="text">Anwendung</th><th data-s="num">Dichte</th><th>Wände</th><th>Muster</th></tr></thead>
  <tbody>
    <tr><td><b>Deko, Figuren, Sichtmodelle</b></td><td>5–10 %</td><td>2</td><td>Lightning oder Support Cubic</td></tr>
    <tr><td><b>Alltagsteile ohne echte Last</b></td><td>15 %</td><td>2–3</td><td>Grid oder CrossHatch</td></tr>
    <tr><td><b>Funktionsteile mit Belastung</b></td><td>20–30 %</td><td>3–4</td><td>Gyroid oder Cubic</td></tr>
    <tr><td><b>Hoch belastet, Zahnräder, Halter</b></td><td>30–40 %</td><td>4–6</td><td>Gyroid, Cubic, 3D Honeycomb</td></tr>
    <tr><td><b>Flexteile aus TPU</b></td><td>5–15 %</td><td>2</td><td>Concentric, Cross, Gyroid</td></tr>
    <tr><td><b>Dicht, wasserführend</b></td><td>100 %</td><td>4+</td><td>Concentric oder Lines, Überextrusion prüfen</td></tr>
  </tbody>
</table></div>
<div class="tip"><b>Reihenfolge beim Verstärken:</b> erst Wandanzahl erhöhen, dann Deckschichten, erst zuletzt die Füllung. Und die Belastungsrichtung beachten — gedruckte Teile versagen fast immer entlang der Schichtebene, kein Infill-Muster gleicht eine falsche Bauteilorientierung aus.</div>

