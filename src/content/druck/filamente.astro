  { n:"Keramik-Fill", w:["Steinoptik, Kunst, Sinterversuche","belastete Teile"], cat:"specialty", k:"keramik sinter stein architekturmodell kunst gruenkoerper", duese:[190,220], bett:[50,60], preis:[35,60], r:[3,3,1,4,4,5], nz:["mid","0,6 mm gehärtet"], t:"Steinoptik. Als Grünkörper mit passendem Binder sinterbar." },

  /* ----------------------------------------------------------------- Support */
  { n:"HIPS", w:["Löslicher Support für ABS","Support unter PLA oder PETG"], cat:"support", k:"support abs ueberhang loeslich limonen stuetzmaterial", duese:[220,240], bett:[90,110], preis:[16,28], r:[4,5,3,6,4,3], nz:["ok","Messing"], t:"Stützmaterial für ABS: löst sich in D-Limonen, druckt sich sonst wie leichtes ABS." },
  { n:"PVA", w:["Wasserlöslicher Support für PLA und PETG","offen gelagerte Spulen"], cat:"support", k:"support wasserloeslich pla hohlraum ueberhang kanal stuetzmaterial", duese:[180,210], bett:[45,60], preis:[30,65], r:[2,2,2,4,1,1], nz:["ok","Messing"], t:"Wasserlöslicher Support. Zieht Feuchte wie ein Schwamm, über 215 °C zersetzt es sich." },
  { n:"BVOH", w:["Schneller löslicher Support, auch unter PETG und PA","kleines Budget"], cat:"support", k:"support wasserloeslich schnell multimaterial serie stuetzmaterial", duese:[190,220], bett:[50,60], preis:[40,75], r:[2,2,2,5,1,1], nz:["ok","Messing"], t:"Löst schneller als PVA und verträgt mehr Trägermaterialien, ist dafür teurer." },
];

const METRICS = [
  { id: "fest", l: "Festigkeit", d: "Zugfestigkeit und Steifigkeit" },
  { id: "hitze", l: "Hitze", d: "Formbeständigkeit in der Wärme" },
  { id: "flex", l: "Flex", d: "Dehnbarkeit, Elastizität" },
  { id: "druck", l: "Druckbar", d: "wie gutmütig es sich drucken lässt" },
  { id: "chem", l: "Chemie", d: "Beständigkeit gegen Öle, Lösemittel, Säuren" },
  { id: "uv", l: "UV", d: "Beständigkeit gegen Sonne und Witterung" },
];

/* Skalen der Bereichsbalken */
const pct = (v, lo, hi) => Math.max(0, Math.min(100, ((v - lo) / (hi - lo)) * 100));
const logPct = (v) => pct(Math.log10(v), Math.log10(10), Math.log10(900));
const range = (a, b, lo, hi) => { const l = pct(a, lo, hi); return `left:${l.toFixed(1)}%;width:${Math.max(3, pct(b, lo, hi) - l).toFixed(1)}%`; };
const priceRange = (a, b) => { const l = logPct(a); return `left:${l.toFixed(1)}%;width:${Math.max(3, logPct(b) - l).toFixed(1)}%`; };
/* Temperaturfarbe: kühl gelb → heiß rot, nach Bereichsmitte */
const heat = (a, b, lo, hi) => `--hue:${Math.round(48 - (pct((a + b) / 2, lo, hi) / 100) * 48)}`;

const count = (id) => F.filter((f) => f.cat === id).length;
---
<div class="kurz"><b>Das Filament entscheidet mehr über das fertige Teil als der Drucker.</b> PLA und PETG decken den Alltag ab; alles darüber kostet beheizten Bauraum, trockenes Material und eine härtere Düse. Die Tabelle vergleicht {F.length} Filamente mit einer Empfehlung, wofür jedes taugt und wofür nicht, darunter {count("cf")} Carbon- und {count("gf")} Glasfaser-Varianten.</div>

<h2>Schnellwahl</h2>
<div class="grid3">
  <div class="card"><div class="ct">Deko, Modelle, Einstieg</div><div class="cd"><b>PLA</b>, für belastete Teile <b>PLA+</b>. Kein Bauraum nötig, kaum Warping, ab ca. 55 °C aber weich. Nichts fürs Auto im Sommer.</div></div>
  <div class="card"><div class="ct">Funktionsteile im Haus</div><div class="cd"><b>PETG</b> oder <b>PCTG</b> als Standard, <b>ABS</b> oder <b>PC-ABS</b> wenn es warm wird oder acetongeglättet werden soll (Einhausung).</div></div>
  <div class="card"><div class="ct">Dauerhaft draußen</div><div class="cd"><b>ASA</b> ist ABS mit UV-Schutz, <b>ASA-CF</b> die steife Variante. <b>PETG</b> geht auch, vergilbt aber langsam; <b>TPC</b> für flexible Außenteile.</div></div>
  <div class="card"><div class="ct">Steif und leicht (CF)</div><div class="cd"><b>PETG-CF</b> als einfacher Einstieg, <b>PET-CF</b> wenn Feuchte stört, <b>PA-CF</b> und <b>PAHT-CF</b> für echte Strukturteile. Gehärtete Düse ist Pflicht.</div></div>
  <div class="card"><div class="ct">Zäh und günstig (GF)</div><div class="cd">Glasfaser ist weniger steif als Carbon, dafür zäher und billiger: <b>PETG-GF</b>, <b>ABS-GF</b> für große Gehäuse, <b>PA6-GF30</b> als Spritzguss-Ersatz.</div></div>
  <div class="card"><div class="ct">Weich und elastisch</div><div class="cd"><b>TPU 95A</b> ist der beherrschbare Standard. 85A und 60A brauchen Direktextruder und sehr niedrige Geschwindigkeit.</div></div>
  <div class="card"><div class="ct">Hitze im Motorraum</div><div class="cd"><b>PAHT-CF</b>, <b>PPA-CF</b> oder <b>PPA-GF</b> halten bis 190 bis über 200 °C. Darüber beginnt PEI und PEEK mit Spezial-Hotend.</div></div>
  <div class="card"><div class="ct">Löslicher Support</div><div class="cd"><b>PVA</b> oder das schnellere <b>BVOH</b> für PLA und PETG, <b>HIPS</b> für ABS (löst sich in D-Limonen).</div></div>
  <div class="card"><div class="ct">CF oder GF?</div><div class="cd"><b>CF</b>: maximal steif, matt, leicht, aber spröder. <b>GF</b>: zäher, schlagfester, günstiger. Beide schleifen Messing in wenigen Spulen ab.</div></div>
</div>

<h3>In fünf Fragen zum Filament</h3>
<p>Die Fragen der Reihe nach durchgehen: Die erste, die zutrifft, grenzt die Auswahl meist schon auf zwei, drei Filamente ein. Die letzte Frage prüft, ob der Drucker das Material überhaupt verarbeiten kann. Den Feinschliff macht die Spalte „Wann nehmen“ in der Tabelle unten.</p>
<div class="steps">
  <div class="step"><h4>Muss es sich biegen oder dämpfen?</h4>Ja: <b>TPU 95A</b> als Standard, weicher mit <b>TPU 85A</b>, draußen <b>TPC</b>. Nein: weiter.</div>
  <div class="step"><h4>Wird es wärmer als 55 °C?</h4>Auto im Sommer, Nähe zu Motoren, Heizung, Spülmaschine. Ja: mindestens <b>PETG</b> (bis etwa 70 °C), darüber <b>ABS</b>, <b>ASA</b> oder <b>PC</b>, im Motorraum <b>PAHT-CF</b> oder <b>PPA-CF</b>. Nein: <b>PLA</b> bleibt im Rennen.</div>
  <div class="step"><h4>Bleibt es dauerhaft draußen?</h4>Ja: <b>ASA</b>, steif <b>ASA-CF</b>, flexibel <b>TPC</b>. PETG geht im Schatten, vergilbt in der Sonne aber langsam.</div>
  <div class="step"><h4>Trägt es Last, Reibung oder Stöße?</h4>Zähigkeit und Schläge: <b>PETG</b>, <b>PCTG</b>, <b>PA12</b>. Reibung und Zahnräder: <b>PA6</b> oder <b>POM</b>. Steif und leicht: <b>PETG-CF</b> zum Einstieg, <b>PA-CF</b> für Strukturteile.</div>
  <div class="step"><h4>Was kann der Drucker?</h4>Offener Drucker mit Messingdüse: PLA, PETG, TPU. Mit Einhausung: zusätzlich ABS, ASA, PC. Mit gehärteter Düse: alles mit CF, GF, Glow und Metall. Mit Trockner: Nylon und PC zuverlässig. Über 300 °C und beheizter Bauraum: PPA, PEI, PEEK.</div>
</div>

