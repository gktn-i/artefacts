<tr><td><b>Schrägkugellager</b></td><td>radial und axial</td><td>hoch</td><td>gering</td><td>Paarweise vorgespannt einbauen — dann spielfrei</td></tr>
<tr><td><b>Kegelrollenlager</b></td><td>hoch, radial und axial</td><td>mittel</td><td>mittel</td><td>Radlager, Spindeln</td></tr>
