<thead><tr><th data-s="text">Strategie</th><th data-s="num">a_p (Tiefe)</th><th data-s="num">a_e (Breite)</th><th>Wofür</th><th>Hinweis</th></tr></thead>
<tbody>
<tr><td><b>Vollnut Holz, Hobby</b></td><td>0,5 – 1 × d</td><td>1 × d</td><td>Konturen, Durchschnitte in Platten</td><td>6-mm-Fräser: 3 – 6 mm je Durchgang in Sperrholz</td></tr>
<tr><td><b>Vollnut Holz, steif</b></td><td>1 – 2 × d</td><td>1 × d</td><td>Schneller schneiden</td><td>Absaugung muss Späne aus der Nut holen</td></tr>
<tr><td><b>Vollnut Kunststoff</b></td><td>0,5 – 1 × d</td><td>1 × d</td><td>Konturen</td><td>Einschneider, Span muss raus, sonst schmilzt es</td></tr>
<tr><td><b>Vollnut Alu, Hobby-Portal</b></td><td>0,1 – 0,25 × d (0,5 – 1,5 mm bei 6 mm)</td><td>1 × d</td><td>Notlösung</td><td>Besser Adaptive. Kühlung Pflicht</td></tr>
