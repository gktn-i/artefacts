<tr><td><b>Adaptive Holz, Kunststoff</b></td><td>2 – 3 × d</td><td>0,2 – 0,4 × d</td><td>Taschen</td><td>Schneller als Vollnut, ganze Schneidenlänge genutzt</td></tr>
<tr><td><b>Schlichten Kontur</b></td><td>volle Tiefe</td><td>0,2 – 0,5 mm</td><td>Endmaß und Oberfläche</td><td>Gleichlauf, letzter Durchgang mit frischer Schneide</td></tr>
<tr><td><b>Schlichten 3D (Kugel)</b></td><td>–</td><td>Stepover 5 – 10 % d</td><td>Reliefs, Formen</td><td>Kleiner Stepover, weniger Nacharbeit, längere Zeit</td></tr>
