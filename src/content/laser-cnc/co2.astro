<thead><tr><th data-s="text">Material</th><th data-s="num">40 W (K40)</th><th data-s="num">55 – 60 W</th><th data-s="num">80 W</th><th data-s="num">100 – 130 W</th><th>Kante</th></tr></thead>
<tbody>
<tr><td><b>Pappelsperrholz</b></td><td>6 mm</td><td>10 mm</td><td>15 mm</td><td>18 mm</td><td>hellbraun bis dunkel, Leim entscheidet</td></tr>
<tr><td><b>Birkensperrholz</b></td><td>4 mm</td><td>6 – 8 mm</td><td>12 mm</td><td>15 mm</td><td>dunkler, Harz und Leim schneiden ungleich</td></tr>
<tr><td><b>MDF</b></td><td>4 mm</td><td>8 mm</td><td>12 mm</td><td>16 mm</td><td>schwarz, viel Rauch</td></tr>
<tr><td><b>Acryl (Guss)</b></td><td>5 mm</td><td>10 – 12 mm</td><td>15 – 20 mm</td><td>25 mm</td><td>flammpoliert, klar</td></tr>
<tr><td><b>Leder</b></td><td>3 mm</td><td>5 mm</td><td>6 mm</td><td>8 mm</td><td>dunkle Kante, riecht</td></tr>
