<thead><tr><th data-s="text">Programm</th><th>Stufe</th><th data-s="num">Preis</th><th>Plattform</th><th>Stärken</th><th>Grenzen</th></tr></thead>
<tbody>
<tr><td><b>Fusion 360</b></td><td>CAD + CAM + Sim</td><td>Personal kostenlos (Hobby, eingeschränkt: kein Rapid, 10 Dokumente aktiv, kein 4-/5-Achs), Standard ~600 €/Jahr</td><td>Win, Mac</td><td>Vollständiges 2,5D- und 3D-CAM, Adaptive Clearing, Simulation, Postprozessoren für alles. Der Standard im Hobby und Kleinbetrieb</td><td>Cloud-Pflicht, Personal-Einschränkungen (Eilgänge werden als G1 ausgegeben), Lernkurve</td></tr>
<tr><td><b>Estlcam</b></td><td>CAM + Steuerung</td><td>60 € einmalig (12 Monate Updates), Test unbegrenzt mit Wartezeit</td><td>Win</td><td>Deutsch, einfach, Trochoidal, Gravur, V-Carve, 3D aus STL, steuert die Maschine direkt mit eigenem Board. Sehr beliebt in DE</td><td>Kein CAD, Oberfläche altmodisch, 3D-CAM einfach</td></tr>
<tr><td><b>Carbide Create</b></td><td>CAD 2D + CAM</td><td>kostenlos, Pro 120 $/Jahr (3D, Textur)</td><td>Win, Mac</td><td>Für Shapeoko gemacht, läuft mit jedem GRBL. Einsteigerfreundlich, V-Carve, Taschen, Konturen</td><td>2,5D, Design einfach</td></tr>
<tr><td><b>Vectric VCarve Desktop / Pro, Aspire</b></td><td>CAD 2D + CAM</td><td>350 / 700 / 2 000 $ einmalig</td><td>Win</td><td>Schilder, V-Carve, Inlays, Reliefs (Aspire), beste Ergebnisse für Holzdeko, Nesting</td><td>Teuer, kein 3D-CAD, Windows</td></tr>
<tr><td><b>Easel (Inventables)</b></td><td>CAD 2D + CAM + Sender</td><td>kostenlos, Pro 240 $/Jahr</td><td>Browser</td><td>Einfachster Einstieg, X-Carve, GRBL</td><td>Cloud, wenig Kontrolle über Wege</td></tr>
<tr><td><b>Kiri:Moto</b></td><td>CAM + Slicer</td><td>kostenlos, Open Source</td><td>Browser</td><td>2,5D und 3D CAM ohne Installation, auch für Onshape</td><td>Weniger Strategien als Fusion</td></tr>
<tr><td><b>FreeCAD CAM (Path)</b></td><td>CAD + CAM</td><td>kostenlos, Open Source</td><td>alle</td><td>Vollständig offen, parametrisch, Postprozessoren anpassbar</td><td>Eigenwillig, 3D-CAM begrenzt, Version 1.0 (2024) deutlich besser als früher</td></tr>
<tr><td><b>Onshape + Kiri:Moto / CAM Studio</b></td><td>CAD (+ CAM)</td><td>Free (öffentliche Dokumente), Standard ab 1 500 $/Jahr</td><td>Browser</td><td>Bestes Browser-CAD, Versionierung</td><td>CAM nur über Zusatz, Free ist öffentlich</td></tr>
